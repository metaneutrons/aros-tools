{
  "name": "aros-tools-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/clean-worker-output.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "worker:prepare": "node scripts/prepare-worker-assets.mjs",
    "worker:check": "npm run worker:prepare && python3 ../scripts/check-docs-publication.py --configuration wrangler.jsonc --assets worker-dist && wrangler deploy --dry-run --outdir .wrangler-output",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "7.0.2",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
