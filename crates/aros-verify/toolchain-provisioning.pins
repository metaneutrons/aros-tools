# Semantic fingerprints of the audited LLVM toolchain-provisioning contract.
#
# aros-verify classifies four `crosstools-*` declarations as toolchain
# provisioning rather than target obligations. That classification is only
# sound for the contract that was actually read, so it is gated on these
# digests: recognise exactly the audited files, and fail closed on anything
# else. `canonical_make_semantics` computes them, so continuations, whitespace
# and ordinary comments do not matter while `#MM` lines do, being MetaMake
# graph input rather than documentation.
#
# Every deliberate change to one of the three sources needs a new value here.
# `cargo test -p aros-verify` prints the actual digest it computed, so re-pin
# from the failure rather than by hand:
#
#   test tests::llvm_provisioning_context_is_semantically_fingerprinted
#   provisioning fingerprints changed: mmake=<hex> config=<hex> cmake=<hex>
#
# The values live in this file and not in a `.rs` constant on purpose. They
# are data about the tree, they change on a different schedule than the code
# that reads them, and while they sat in the source file every re-pin was a
# code edit -- which is what tied them to the module layout the refactor has
# to be free to change. See OPEN-POINTS 7.

# tools/crosstools/llvm/mmakefile.src
llvm-mmakefile = 451406c625d28b16889ae746f725ff28cb368356ee7d18061d257f59966019cb

# tools/crosstools/llvm.cfg
llvm-config = 00554cab8dc4319473490233574700530eb6ae463fe4c97a2ddfd87cf02ad7a0

# The toolchain-input preamble of the top-level CMakeLists.txt
cmake-toolchain-input = 5c2d0de107d41bd90635868517f4577df229d0afda3208c572df9b37d50025f9
