# Exact capability fingerprints
#
# These are recipe/inventory fingerprints, not package or download pins.
# Ordinary repository fetch declarations and local patches remain tracked
# inputs. The closed Target-LLVM capability separately binds its audited
# LLVM 11 archive checksum; that source identity is not a recipe fingerprint.
#
# A fingerprint is allowed here only when the transpiler expands an opaque
# legacy recipe or a versioned source inventory into a hard-coded executable
# job graph. If those bytes change, continuing would execute stale assumptions.
# The transpiler therefore exits with the affected path, expected and observed
# fingerprints, and an explicit request to review and update the capability.
# Never re-pin one of these merely to make a build pass.

# Mesa SSE4.1: opaque recipe/configuration fragments and the exact inventory
# consumed by the hard-coded lane.
mesa-sse41-capability = 70cd3cc7603b73fba1f5048621cd95bfcde8632d1425664fa9982c6aab4e0fac
mesa-sse41-local-context = c954ef928824194f9b91208946e00482d9d1d83cc9496f137cf3a9d92e93b320
mesa-sse41-config-context = 397ce5db99a5540e0436680d3e951b5dedab9c177ff60d03b8916db25d20230f
mesa-sse41-manifest = 4cf786a7beef96b541213b992adf4df84e866afb8f8b2ef855b119f097538497

# Opaque hand-written generator recipe blocks whose jobs are materialised by
# the transpiler rather than executed as arbitrary shell.
glapi-generator-capability = c42d77ef950bf439e04c36df203309c24a3a931b0c294edce875ae969d8143e5
mesautil-generator-capability = 9ff6ca66c503c1671c6bbd2a2d0b8a9a449a3368a8fcbed29425eb7d7d3fd908

# Mesa 26 glapi is a separate two-stage generated archive. The full source
# recipe is pinned because the cold-tree evaluator cannot import mesa.cfg.
mesa26-glapi-recipe = 0c7e7651effa1715778aa6372481f60149b1de1fb5ffd58f6e9079d8cef3fec4 # gitleaks:allow -- public SHA-256 of the audited source recipe, not a credential
mesa26-egl-recipe = 7b508e09f4b908528ae4cbe336449440e52f0e043ea0a219b9e6a7f000a59bc4 # gitleaks:allow -- public SHA-256 of the audited Mesa 26 EGL recipe
mesa26-config = 98ff8a696038f5b3ecd5734d2a36f5113de997a096f0b29a83e4f16c2b51bbaa

# Remaining Mesa generator lanes. Each recipe fingerprint is paired with the
# versioned inventory from which its hard-coded generator output closure was
# reviewed.
mesa20-compiler-recipe = 3103a5586624c6a92b2201838fbb8c1731c9bb140a40e917385031f699f106f1
mesa20-compiler-manifest = 88cdeedf3091fadf1678af939ed582329523081b748f2b0abd39ae3e6f5f2481
mesa20-galliumaux-recipe = d551dd76dab655bb1d1cc14b4364cba7d4f5827fc78fb537847963b8850f7e53
mesa20-galliumaux-manifest = eebe8fe19dd4cc1531d93a72ac8ca8e38408a7ecad3799f3f896663a2f996705
mesa20-core-recipe = bef0c54aea29752d2b5cc3b70fd7f991d34c29ba294adb75d458fb5fda8d1bc1
mesa20-core-manifest = 61c034fdbd34bf963c73cf1d89765dbc10ad45865c0d42f4d6f8c60dd0bbbfcc
mesa20-vc4-recipe = 04f2d449ef30ebb4b9dc9fa1fea55865303d9335c4873c7845cfb16eadf1484c
