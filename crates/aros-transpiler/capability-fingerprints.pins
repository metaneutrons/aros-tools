# The archive rule gained gca_private.list as a prerequisite so that plain
# MetaMake orders it. Both revisions expand to the same jobs. The CMake engine already generates it together with
# gca_redefs.txt in one command that the archive rewrite depends on.
mesa26-vc4-recipe = e1317c1cc0689a537b6b65bf60ea08378cdc57b621be07ec1a0dd2546ceeaa9f
mesa26-vc4-recipe-without-private-list = 0be62fd0125ffd144ede01d53b0c611cd5185ff8b866b2d77c13829f6aae1f54
mesa26-vc4-manifest = c6d8a4b861650bcabefa75bff26b1ba9e1949773c39dcd9a8ab1db4660fb51b4

# Mesa 26's target LLVM lane expands a versioned Gallivm inventory, a recipe
# source list, and the local HIDD recipe into closed archive/module sources.
# libc++ 23 needs its headers ahead of the posixc ones, so the recipe puts
# -nostdinc++ and the libc++ directory into USER_CXXFLAGS for LLVM toolchains.
# The earlier revision stays admitted: both expand to the same lane.
# This lane is closed on LLVM 11 (HAVE_LLVM=0x0b00) and takes its flags from the
# compile contract, not from the recipe, so the change does not apply here.
mesa26-gallivm-recipe = 083cb94858027da8e5cf78581acfc1c9bd28b15473b15b48a3e0702e1fe4cb62
mesa26-gallivm-recipe-without-libcxx-order = 3a6d383b548f0702783c181c2f8e7b999f48e8c2ff36db9e494073715bd2add4
mesa26-gallivm-recipe-with-llvm23-default = 1a092caee8918144a23bf7b5a4510909c81478b4c15c98e89b4241cc0d1e20ee
mesa26-gallivm-manifest = 7b4d7686b57b128fe2de662a223baf943e75a8ae2f434fe7c593cba631365f41
mesa26-llvmpipe-recipe = 69e33ce5cd26222b774f8193b818f7a49034e959731ee45587f4d39239e14daf
mesa26-llvmpipe-recipe-with-llvm23-default = b6447bd38f04ff275ae6ee52fc3472cb4e6755917cde0a5f3118377aa6e91414
mesa26-llvmpipe-hidd-recipe = 7af9894c09343c3fe423467f8b64eb415cfeabcc8f69c21cf5432bc40a165d15

# LLVM target recipes are expanded into version-specific fixed external
# providers. The earlier LLVM 11 revision stays admitted because disabling
# precompiled headers only changes build time. The LLVM 23 default revision is
# admitted only for either the explicit legacy selector or the closed LLVM 23
# monorepo provider.
llvm11-target-recipe = 4f95d02cdaca1e124abc4ada281390b702e9991f5932eb8bda5fd2c12ada7ef1
llvm11-target-recipe-with-precompiled-headers = d5ea6a24e95c19997b841659ff4c943f6a3ed13f6e7e7569b662597f65ac4b80
llvm-target-recipe-with-llvm23-default = d8ce81b9703733fec39c416caae77bf2ea65a1130bb534cd1725d0c7f226543d
