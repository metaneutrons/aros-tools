cmake_minimum_required(VERSION 3.24)
get_filename_component(_engine "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_root "${CMAKE_CURRENT_BINARY_DIR}/mesa proxy origin")
file(MAKE_DIRECTORY "${_root}/source")
file(WRITE "${_root}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(MesaProxyOrigin LANGUAGES C CXX)
list(PREPEND CMAKE_MODULE_PATH "${ENGINE}/tests/source-resolution/cmake")
set(AROS_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
set(AROS_TARGET_CPU x86_64)
set(AROS_TARGET_PLATFORM pc)
file(MAKE_DIRECTORY "${AROS_SOURCE_DIR}/compiler/startup")
file(WRITE "${AROS_SOURCE_DIR}/compiler/startup/startup.c" "int startup_fixture;\n")
file(WRITE "${AROS_SOURCE_DIR}/compiler/startup/detach.c" "int detach_fixture;\n")
include("${ENGINE}/AROS.cmake")
include("${ENGINE}/ConfiguredMesaSources.cmake")
if(COMMAND _aros_mesa_source_compile_contract)
    message(FATAL_ERROR "test-only Mesa compile helper leaked into productive module")
endif()
include("${ENGINE}/tests/support/ConfiguredMesaSourceCompileContract.cmake")
set(_ports "${CMAKE_BINARY_DIR}/Ports/mesa/src")
file(MAKE_DIRECTORY "${_ports}" "${AROS_SOURCE_DIR}/module")
set(_c "${_ports}/cprobe.c")
set(_xx "${_ports}/probe.cpp")
file(WRITE "${_c}" "_Static_assert(__builtin_strcmp(__SRCFILENAME__, \"Ports/mesa/src/cprobe.c\") == 0, \"wrong original identity\");\nint c_probe;\n")
file(WRITE "${_xx}" "static_assert(__builtin_strcmp(__SRCFILENAME__, \"Ports/mesa/src/probe.cpp\") == 0, \"wrong original identity\");\nint xx_probe;\n")
if(CASE STREQUAL "cold")
    file(REMOVE "${_xx}")
endif()
_aros_port_source_proxy(_proxy "${_ports}/cprobe" C FALSE)
_aros_port_source_proxy(_proxyxx "${_ports}/probe" CXX FALSE)
_aros_port_source_proxy(_again "${_ports}/cprobe" C FALSE)
if(NOT _again STREQUAL _proxy)
    message(FATAL_ERROR "producer repeat changed its exact proxy identity")
endif()
if(CASE STREQUAL "absent")
    file(REMOVE "${_xx}")
elseif(CASE STREQUAL "ambiguous")
    file(WRITE "${_ports}/probe.cxx" "int ambiguous;\n")
elseif(CASE STREQUAL "tampered")
    file(APPEND "${_proxyxx}" "#error changed proxy\n")
elseif(CASE STREQUAL "unregistered")
    set(_proxyxx "${CMAKE_BINARY_DIR}/manual.cpp")
    file(WRITE "${_proxyxx}" "#include \"${_xx}\"\n")
elseif(CASE STREQUAL "symlink")
    file(RENAME "${_xx}" "${_xx}.held")
    file(CREATE_LINK "${_xx}.held" "${_xx}" SYMBOLIC)
elseif(CASE STREQUAL "symlink-parent")
    file(RENAME "${_ports}" "${_ports}-held")
    file(CREATE_LINK "${_ports}-held" "${_ports}" SYMBOLIC)
elseif(CASE STREQUAL "proxy-symlink")
    file(REMOVE "${_proxyxx}")
    file(WRITE "${_proxyxx}.held" "sentinel-must-not-change")
    file(CREATE_LINK "${_proxyxx}.held" "${_proxyxx}" SYMBOLIC)
    file(WRITE "${CMAKE_BINARY_DIR}/guarded-path.txt" "${_proxyxx}.held")
    string(SHA256 _hash "CXX|FALSE|${_ports}/probe")
    set_property(GLOBAL PROPERTY "AROS_PORT_SOURCE_PROXY_${_hash}")
    _aros_port_source_proxy(_unexpected "${_ports}/probe" CXX FALSE)
elseif(CASE STREQUAL "proxy-directory")
    set(_directory "${CMAKE_BINARY_DIR}/CMakeFiles/aros-port-sources")
    file(RENAME "${_directory}" "${_directory}-held")
    file(CREATE_LINK "${_directory}-held" "${_directory}" SYMBOLIC)
    _aros_port_source_proxy(_unexpected "${_ports}/probe" CXX FALSE)
endif()
_aros_mesa_proxy_original(_selected "${_proxyxx}")
if(NOT _selected STREQUAL _xx)
    message(FATAL_ERROR "proxy candidate did not retain its exact original")
endif()
_aros_mesa_proxy_original(_selected_c "${_proxy}")
if(NOT _selected_c STREQUAL _c)
    message(FATAL_ERROR "C proxy candidate lost its original")
endif()
if(CASE STREQUAL "wrong-original")
    set(_selected_c "${_xx}")
endif()
if(CASE STREQUAL "legacy-late-counter")
    add_library(selected OBJECT "${_proxyxx}")
    set_property(TARGET selected PROPERTY COMPILE_OPTIONS "")
    target_compile_definitions(selected PRIVATE __SRCFILENAME__="Ports/mesa/src/probe.cpp")
    return()
endif()
add_library(selected OBJECT "${_proxy}" "${_proxyxx}")
add_library(ordinary-legacy OBJECT EXCLUDE_FROM_ALL "${_proxy}" "${_proxyxx}")
file(WRITE "${CMAKE_BINARY_DIR}/required-object-input.txt" "owned dependency\n")
set_source_files_properties("${_proxyxx}" PROPERTIES OBJECT_DEPENDS "${CMAKE_BINARY_DIR}/required-object-input.txt")
if(CASE STREQUAL "header-only")
    set_source_files_properties("${_proxy}" PROPERTIES HEADER_FILE_ONLY TRUE)
endif()
# Remove AROS's ordinary target defaults: this fixture checks the closed
# source contract, not host compilation of a cross-target baseline.
set_property(TARGET selected PROPERTY COMPILE_OPTIONS "")
_aros_mesa_source_compile_contract(selected "${_proxy}" "${_selected_c}" "${AROS_SOURCE_DIR}/module" C
    "/nominal/make/Ports/mesa/src/cprobe.c" "/nominal/source" "/nominal/make" "${AROS_BUILD_DIR}/module" -DMEASURED=1)
_aros_mesa_source_compile_contract(selected "${_proxyxx}" "${_selected}" "${AROS_SOURCE_DIR}/module" CXX
    "/nominal/make/Ports/mesa/src/probe.cpp" "/nominal/source" "/nominal/make" "${AROS_BUILD_DIR}/module" -DMEASURED=1)
get_target_property(_ordinary_sources ordinary-legacy SOURCES)
if(NOT _ordinary_sources STREQUAL "${_proxy};${_proxyxx}")
    message(FATAL_ERROR "freezing changed the ordinary target's exact source list")
endif()
get_target_property(_frozen_sources selected SOURCES)
list(LENGTH _frozen_sources _frozen_count)
if(NOT _frozen_count EQUAL 2)
    message(FATAL_ERROR "frozen target changed its source count")
endif()
set(_observed_stems "")
foreach(_frozen IN LISTS _frozen_sources)
    if(_frozen STREQUAL _proxy OR _frozen STREQUAL _proxyxx)
        message(FATAL_ERROR "selected target still has a fallback proxy")
    endif()
    _aros_source_object_stem(_stem "${_frozen}")
    list(APPEND _observed_stems "${_stem}")
    string(SHA256 _key "${_frozen}")
    get_property(_original GLOBAL PROPERTY "AROS_MESA_FROZEN_ORIGINAL_${_key}")
    if(NOT _original STREQUAL _c AND NOT _original STREQUAL _xx)
        message(FATAL_ERROR "frozen wrapper lost its recorded exact original")
    endif()
endforeach()
if(NOT _observed_stems STREQUAL "cprobe;probe")
    message(FATAL_ERROR "frozen wrappers changed logical object names")
endif()
]=])
foreach(_case IN ITEMS good late-candidate legacy-late-counter absent cold ambiguous tampered
        unregistered symlink symlink-parent wrong-original proxy-symlink proxy-directory
        header-only dependency-removed)
    set(_build "${_root}/build-${_case}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_root}/source" -B "${_build}"
        -G Ninja "-DENGINE=${_engine}" "-DCASE=${_case}"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(_case MATCHES "^(good|late-candidate|legacy-late-counter|dependency-removed)$")
        if(NOT _status EQUAL 0)
            message(FATAL_ERROR "real proxy producer configure failed: ${_out}${_err}")
        endif()
        if(_case MATCHES "late")
            file(WRITE "${_build}/Ports/mesa/src/probe" "#error changed source selected after configure\n")
        endif()
        if(_case STREQUAL "dependency-removed")
            file(REMOVE "${_build}/required-object-input.txt")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" --build "${_build}" --parallel 1
            RESULT_VARIABLE _status OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
        if(_case STREQUAL "legacy-late-counter")
            if(_status EQUAL 0 OR NOT "${_out}${_err}" MATCHES "changed source selected after configure")
                message(FATAL_ERROR "legacy proxy counter did not prove branch change: ${_out}${_err}")
            endif()
        elseif(_case STREQUAL "dependency-removed")
            if(_status EQUAL 0 OR NOT "${_out}${_err}" MATCHES "required-object-input.txt.*missing")
                message(FATAL_ERROR "frozen source lost its exact object dependency: ${_out}${_err}")
            endif()
        elseif(NOT _status EQUAL 0)
            message(FATAL_ERROR "real proxy producer C/CXX compile failed: ${_out}${_err}")
        endif()
        continue()
    endif()
    if(_case STREQUAL "absent" OR _case STREQUAL "cold")
        set(_reason "exactly one selected original source, got 0")
    elseif(_case STREQUAL "ambiguous")
        set(_reason "exactly one selected original source, got 2")
    elseif(_case STREQUAL "tampered")
        set(_reason "changed after producer registration")
    elseif(_case STREQUAL "unregistered")
        set(_reason "no registered source producer")
    elseif(_case STREQUAL "symlink")
        set(_reason "undeclared symlink")
    elseif(_case STREQUAL "wrong-original")
        set(_reason "original differs from registered proxy selection")
    elseif(_case STREQUAL "symlink-parent")
        set(_reason "symlinked ancestor")
    elseif(_case STREQUAL "proxy-symlink")
        set(_reason "not a regular owned path")
        file(READ "${_build}/guarded-path.txt" _guarded)
        file(READ "${_guarded}" _sentinel)
        if(NOT _sentinel STREQUAL "sentinel-must-not-change")
            message(FATAL_ERROR "proxy producer wrote through its forbidden symlink")
        endif()
    elseif(_case STREQUAL "proxy-directory")
        set(_reason "proxy directory is a symlink")
    elseif(_case STREQUAL "header-only")
        set(_reason "not a compilable source")
    endif()
    if(_status EQUAL 0 OR NOT "${_out}${_err}" MATCHES "${_reason}")
        message(FATAL_ERROR "${_case} refused for wrong reason: ${_out}${_err}")
    endif()
endforeach()
