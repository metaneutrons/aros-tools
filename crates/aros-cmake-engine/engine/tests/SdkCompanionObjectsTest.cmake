cmake_minimum_required(VERSION 3.22)
if(NOT DEFINED ENGINE_DIR OR NOT DEFINED TEST_BINARY_DIR)
    message(FATAL_ERROR "engine/test roots required")
endif()
file(MAKE_DIRECTORY "${TEST_BINARY_DIR}")
foreach(case positive absent wrong-class wrong-machine wrong-library override)
    set(build "${TEST_BINARY_DIR}/sdk-companion-${case}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -G Ninja
        -S "${ENGINE_DIR}/tests/sdk-companion" -B "${build}"
        "-DENGINE_DIR=${ENGINE_DIR}" "-DCASE=${case}"
        RESULT_VARIABLE configured OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(case MATCHES "^(absent|wrong-library|override)$")
        if(configured EQUAL 0)
            message(FATAL_ERROR "${case}: unsafe configure accepted")
        endif()
        if(case STREQUAL "absent" AND NOT error MATCHES "exactly one validated role")
            message(FATAL_ERROR "${case}: unexpected refusal: ${error}")
        endif()
        if(case STREQUAL "wrong-library" AND NOT error MATCHES "output differs")
            message(FATAL_ERROR "${case}: unexpected refusal: ${error}")
        endif()
        if(case STREQUAL "override" AND NOT error MATCHES "cannot override compiler target")
            message(FATAL_ERROR "${case}: unexpected refusal: ${error}")
        endif()
        continue()
    endif()
    if(NOT configured EQUAL 0)
        message(FATAL_ERROR "${case}: configure failed: ${output}\n${error}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --target companion
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(case STREQUAL "positive")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "positive build failed: ${output}\n${error}")
        endif()
        file(READ "${build}/SYS/Developer/lib32/probe.o" header OFFSET 0 LIMIT 20 HEX)
        if(NOT header MATCHES "^7f454c460101" OR NOT header MATCHES "01000300$")
            message(FATAL_ERROR "positive object is not ELF32 little-endian i386 ET_REL")
        endif()
        find_program(clang_driver NAMES clang REQUIRED)
        find_program(touch_program NAMES touch REQUIRED)
        set(published "${build}/SYS/Developer/lib32/probe.o")
        file(COPY_FILE "${published}" "${build}/original.o")
        execute_process(COMMAND "${clang_driver}" --target=x86_64-unknown-aros
            -c "${build}/source/probe.c" -o "${build}/wrong-abi.o" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "incremental ABI counterprobe compiler failed")
        endif()
        file(COPY_FILE "${build}/wrong-abi.o" "${published}")
        execute_process(COMMAND "${touch_program}" -r "${build}/original.o" "${published}" RESULT_VARIABLE touched)
        if(NOT touched EQUAL 0)
            message(FATAL_ERROR "timestamp-preserving counterprobe failed")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --target companion
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "companion ELF class/endian/type/machine differs")
            message(FATAL_ERROR "incremental wrong-ABI object was not rejected: ${output}\n${error}")
        endif()
        file(WRITE "${build}/source/counter.c" "int different_companion(void) { return 99; }\n")
        execute_process(COMMAND "${clang_driver}" --target=i386-unknown-aros
            -c "${build}/source/counter.c" -o "${build}/wrong-bytes.o" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "incremental byte counterprobe compiler failed")
        endif()
        file(COPY_FILE "${build}/wrong-bytes.o" "${published}")
        execute_process(COMMAND "${touch_program}" -r "${build}/original.o" "${published}")
        execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --target companion
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "existing object differs from compiler output")
            message(FATAL_ERROR "incremental changed bytes were not rejected: ${output}\n${error}")
        endif()
    else()
        if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "companion ELF class/endian/type/machine differs")
            message(FATAL_ERROR "${case}: ABI counterprobe did not discriminate: ${output}\n${error}")
        endif()
        if(EXISTS "${build}/SYS/Developer/lib32/probe.o")
            message(FATAL_ERROR "${case}: invalid object was published")
        endif()
    endif()
endforeach()
