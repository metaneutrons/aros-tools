function(_write_input directory payload out_manifest)
    file(WRITE "${directory}/payload.txt" "${payload}")
    file(SIZE "${directory}/payload.txt" _size)
    file(SHA256 "${directory}/payload.txt" _hash)
    set(${out_manifest}
        "[{\"filename\":\"payload.txt\",\"sha256\":\"${_hash}\",\"size\":${_size}}]"
        PARENT_SCOPE)
endfunction()

