function(_configure_fixture build probe cache manifest source_manifest)
    set(_args
        -S "${_source}" -B "${build}" -G Ninja
        "-DAROS_HOST_C_FILE_GENERATOR_ENGINE=${_engine_dir}"
        "-DHCF_HOST_CC=${_host_cc}"
        "-DHCF_INPUT_DIRECTORY=${cache}"
        "-DHCF_INPUT_MANIFEST_JSON=${manifest}"
        "-DHCF_SOURCE_MANIFEST_JSON=${source_manifest}"
        "-DHCF_PROBE=${probe}")
    if(_tool_override)
        list(APPEND _args "-DHCF_TOOL_SOURCE_OVERRIDE=${_tool_override}")
    endif()
    if(_tool_sha256_override)
        list(APPEND _args "-DHCF_TOOL_SHA256_OVERRIDE=${_tool_sha256_override}")
    endif()
    if(_source_root_override)
        list(APPEND _args "-DHCF_SOURCE_ROOT_OVERRIDE=${_source_root_override}")
    endif()
    if(_output_override)
        list(APPEND _args "-DHCF_OUTPUT_OVERRIDE=${_output_override}")
    endif()
    if(_real_reference)
        list(APPEND _args "-DHCF_REAL_REFERENCE=ON")
    endif()
    execute_process(COMMAND "${_cmake}" ${_args}
        RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
    set(_configure_result "${_result}" PARENT_SCOPE)
    set(_configure_log "${_stdout}\n${_stderr}" PARENT_SCOPE)
endfunction()

function(_build_fixture build expect_success out_log)
    set(_run_log "${_root}/generator invocations.log")
    execute_process(
        COMMAND "${_cmake}" -E env "HCF_TEST_RUN_LOG=${_run_log}"
            "${_cmake}" --build "${build}" --target host-c-fixture --parallel 2
        RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
    set(_log "${_stdout}\n${_stderr}")
    set(${out_log} "${_log}" PARENT_SCOPE)
    if(expect_success AND NOT _result EQUAL 0)
        message(FATAL_ERROR "host C generator build failed (${_result})\n${_log}")
    elseif(NOT expect_success AND _result EQUAL 0)
        message(FATAL_ERROR "host C generator build unexpectedly succeeded\n${_log}")
    endif()
endfunction()

function(_assert_invocations expected)
    set(_run_log "${_root}/generator invocations.log")
    if(EXISTS "${_run_log}")
        file(STRINGS "${_run_log}" _lines)
    else()
        set(_lines "")
    endif()
    list(LENGTH _lines _count)
    if(NOT _count EQUAL expected)
        message(FATAL_ERROR "generator invocation count was ${_count}, expected ${expected}")
    endif()
endfunction()

function(_expect_configure_failure probe expected_text cache manifest source_manifest)
    set(_build "${_root}/configure-${probe}")
    _configure_fixture("${_build}" "${probe}" "${cache}" "${manifest}" "${source_manifest}")
    if(_configure_result EQUAL 0 OR NOT _configure_log MATCHES "${expected_text}")
        message(FATAL_ERROR
            "configure probe ${probe} was not rejected as expected; result=${_configure_result}\n${_configure_log}")
    endif()
endfunction()

