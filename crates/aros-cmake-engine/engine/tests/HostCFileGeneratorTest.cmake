if(DEFINED ENV{AROS_TEST_P4_SOURCE} AND
   NOT "$ENV{AROS_TEST_P4_SOURCE}" STREQUAL "" AND
   DEFINED ENV{AROS_TEST_GENCTBL_INPUTS} AND
   NOT "$ENV{AROS_TEST_GENCTBL_INPUTS}" STREQUAL "")
    set(_reference_source "$ENV{AROS_TEST_P4_SOURCE}")
    file(REAL_PATH "${_reference_source}" _reference_source)
    if(IS_DIRECTORY "${_reference_source}")
        set(_reference_root "${_reference_source}")
        set(_reference_source "${_reference_root}/tools/genctbl/genctbl.c")
    else()
        get_filename_component(_reference_genctbl_dir "${_reference_source}" DIRECTORY)
        get_filename_component(_reference_tools_dir "${_reference_genctbl_dir}" DIRECTORY)
        get_filename_component(_reference_root "${_reference_tools_dir}" DIRECTORY)
    endif()
    file(REAL_PATH "${_reference_root}" _reference_root)
    file(REAL_PATH "$ENV{AROS_TEST_GENCTBL_INPUTS}" _reference_inputs)
    file(SHA256 "${_reference_source}" _reference_tool_sha)
    if(NOT _reference_tool_sha STREQUAL "91033690a36ceed218b07f9643022a29b2c548c9d1bbaf31e3958c09843d3933")
        message(FATAL_ERROR "opt-in genctbl source does not match the locked reference")
    endif()
    set(_reference_manifest "[{
        \"filename\":\"UnicodeData.txt\",\"sha256\":\"ff58e5823bd095166564a006e47d111130813dcf8bf234ef79fa51a870edb48f\",\"size\":2175362},
        {\"filename\":\"SpecialCasing.txt\",\"sha256\":\"8d5de354eef79f2395a54c9c7dcebbaf3d30fc962d0f85611ea97aa973a0c451\",\"size\":16809}
    ]")
    foreach(_reference_input IN ITEMS UnicodeData.txt SpecialCasing.txt)
        if(NOT EXISTS "${_reference_inputs}/${_reference_input}" OR
           IS_SYMLINK "${_reference_inputs}/${_reference_input}")
            message(FATAL_ERROR "opt-in genctbl input is missing or symlinked: ${_reference_input}")
        endif()
    endforeach()
    file(SIZE "${_reference_inputs}/UnicodeData.txt" _unicode_size)
    file(SHA256 "${_reference_inputs}/UnicodeData.txt" _unicode_sha)
    file(SIZE "${_reference_inputs}/SpecialCasing.txt" _special_size)
    file(SHA256 "${_reference_inputs}/SpecialCasing.txt" _special_sha)
    if(NOT _unicode_size EQUAL 2175362 OR
       NOT _unicode_sha STREQUAL "ff58e5823bd095166564a006e47d111130813dcf8bf234ef79fa51a870edb48f" OR
       NOT _special_size EQUAL 16809 OR
       NOT _special_sha STREQUAL "8d5de354eef79f2395a54c9c7dcebbaf3d30fc962d0f85611ea97aa973a0c451")
        message(FATAL_ERROR "opt-in genctbl inputs differ from the locked reference")
    endif()

    set(_reference_build "${_root}/genctbl reference build")
    set(_reference_output "${_reference_build}/gen/en_GB_ISO8859-1.c")
    set(_reference_direct_dir "${_root}/direct genctbl output")
    set(_reference_direct_tool "${_root}/direct genctbl")
    file(MAKE_DIRECTORY "${_reference_direct_dir}")
    execute_process(COMMAND "${_host_cc}" -g -Wall -Werror -Wunused -O2
        "${_reference_source}" -o "${_reference_direct_tool}"
        RESULT_VARIABLE _direct_compile_result OUTPUT_VARIABLE _direct_compile_out
        ERROR_VARIABLE _direct_compile_err)
    if(NOT _direct_compile_result EQUAL 0)
        message(FATAL_ERROR "independent genctbl compile failed\n${_direct_compile_out}\n${_direct_compile_err}")
    endif()
    execute_process(COMMAND "${_reference_direct_tool}" "${_reference_inputs}"
        "${_reference_direct_dir}" en_GB_ISO8859-1 --emit-c
        RESULT_VARIABLE _direct_run_result OUTPUT_VARIABLE _direct_run_out
        ERROR_VARIABLE _direct_run_err)
    if(NOT _direct_run_result EQUAL 0)
        message(FATAL_ERROR "independent genctbl run failed\n${_direct_run_out}\n${_direct_run_err}")
    endif()
    set(_reference_direct_output "${_reference_direct_dir}/en_GB_ISO8859-1.c")
    file(SIZE "${_reference_direct_output}" _direct_output_size)
    file(SHA256 "${_reference_direct_output}" _direct_output_sha)
    if(NOT _direct_output_size EQUAL 6180 OR
       NOT _direct_output_sha STREQUAL "7906b7ca6d758463ee1788febca54b7e0a5d864f63a6c5bb070b5f1300830209")
        message(FATAL_ERROR "independent genctbl output differs from locked reference")
    endif()

    set(_tool_override "${_reference_source}")
    set(_source_root_override "${_reference_root}")
    set(_output_override "${_reference_output}")
    set(_real_reference TRUE)
    _configure_fixture("${_reference_build}" "" "${_reference_inputs}"
        "${_reference_manifest}" "[]")
    unset(_tool_override)
    unset(_source_root_override)
    unset(_output_override)
    unset(_real_reference)
    if(NOT _configure_result EQUAL 0)
        message(FATAL_ERROR "opt-in genctbl fixture configure failed\n${_configure_log}")
    endif()
    _build_fixture("${_reference_build}" TRUE _reference_log)
    file(SIZE "${_reference_output}" _reference_output_size)
    file(SHA256 "${_reference_output}" _reference_output_sha)
    if(NOT _reference_output_size EQUAL _direct_output_size OR
       NOT _reference_output_sha STREQUAL _direct_output_sha)
        message(FATAL_ERROR "host C generator output differs from independent genctbl output")
    endif()
    execute_process(COMMAND "${_cmake}" -E compare_files
        "${_reference_output}" "${_reference_direct_output}"
        RESULT_VARIABLE _compare_result)
    if(NOT _compare_result EQUAL 0)
        message(FATAL_ERROR "host C generator output differs byte-for-byte from direct genctbl")
    endif()
    message(STATUS "opt-in genctbl reference output matches the independent build")
endif()

message(STATUS "host C file generator tests passed: no-op, repair, sealed input/source/tool checks, refusal preservation, and path/output attacks")
