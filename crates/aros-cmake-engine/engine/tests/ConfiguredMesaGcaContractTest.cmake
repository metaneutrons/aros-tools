cmake_minimum_required(VERSION 3.24)
set(_tmp "$ENV{TMPDIR}")
if(NOT _tmp)
    set(_tmp /tmp)
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _suffix)
set(_root "${_tmp}/configured-mesa-gca-${_suffix}")
file(MAKE_DIRECTORY "${_root}/source")
file(WRITE "${_root}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(ConfiguredMesaGca NONE)
include("${GCA_MODULE}")
add_library(vc4 INTERFACE)
set_property(TARGET vc4 PROPERTY AROS_MESA_CONFIGURED_CONTRACT TRUE)
set_property(TARGET vc4 PROPERTY AROS_ORDERED_COMPILE_CONTRACT_LANGUAGES "C;CXX")
set(_expected "-marm -DORDER=1 -UORDER -DORDER=1")
set_property(TARGET vc4 PROPERTY AROS_MESA_GCA_ABI_FLAGS "${_expected}")
if(CASE STREQUAL "missing-language")
    set_property(TARGET vc4 PROPERTY AROS_ORDERED_COMPILE_CONTRACT_LANGUAGES C)
elseif(CASE STREQUAL "overlapping-language")
    set_property(TARGET vc4 PROPERTY AROS_ORDERED_COMPILE_CONTRACT_LANGUAGES "C;CXX;ALL")
elseif(CASE STREQUAL "static")
    set_property(TARGET vc4 PROPERTY AROS_MESA_CONFIGURED_CONTRACT FALSE)
elseif(CASE STREQUAL "missing-flags")
    set_property(TARGET vc4 PROPERTY AROS_MESA_GCA_ABI_FLAGS)
elseif(CASE STREQUAL "empty-flags")
    set_property(TARGET vc4 PROPERTY AROS_MESA_GCA_ABI_FLAGS "")
elseif(CASE STREQUAL "unsafe-flags")
    set_property(TARGET vc4 PROPERTY AROS_MESA_GCA_ABI_FLAGS "-Dfirst;-Dsecond")
endif()
_aros_mesa26_configured_gca_flags(_actual vc4)
if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Frozen Make GCA argument order/duplicates changed")
endif()
add_library(provider INTERFACE)
set_property(TARGET provider PROPERTY AROS_MESA_CONFIGURED_CONTRACT TRUE)
set_property(TARGET provider PROPERTY AROS_ORDERED_COMPILE_CONTRACT_LANGUAGES "C;CXX")
if(CASE STREQUAL "mixed-provider")
    set_property(TARGET provider PROPERTY AROS_MESA_CONFIGURED_CONTRACT FALSE)
elseif(CASE STREQUAL "partial-provider")
    set_property(TARGET provider PROPERTY AROS_ORDERED_COMPILE_CONTRACT_LANGUAGES C)
endif()
if(CASE STREQUAL "missing-provider")
    _aros_mesa26_require_configured_targets(vc4 absent)
else()
    _aros_mesa26_require_configured_targets(vc4 provider)
endif()
]=])
foreach(_case IN ITEMS positive missing-language overlapping-language static missing-flags empty-flags unsafe-flags
                       mixed-provider partial-provider missing-provider)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        -S "${_root}/source" -B "${_root}/${_case}"
        "-DGCA_MODULE=${CMAKE_CURRENT_LIST_DIR}/../Mesa26GalliumCoreAPI.cmake"
        "-DCASE=${_case}"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
    if(_case STREQUAL "positive")
        if(NOT _status EQUAL 0)
            message(FATAL_ERROR "Configured GCA positive failed: ${_stdout}${_stderr}")
        endif()
    elseif(_status EQUAL 0 OR NOT "${_stdout}${_stderr}" MATCHES
           "Configured Mesa GCA (requires complete ordered compilation|cannot mix static and configured targets|target is missing)")
        message(FATAL_ERROR "Configured GCA ${_case} counter failed: ${_stdout}${_stderr}")
    endif()
endforeach()
message(STATUS "Configured Mesa GCA exact-string positive and nine refusal probes passed")
