cmake_minimum_required(VERSION 3.24)
get_filename_component(_engine "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_root "${CMAKE_CURRENT_BINARY_DIR}/mesa genmodule origin")
file(MAKE_DIRECTORY "${_root}/source")
file(WRITE "${_root}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(MesaGeneratedOrigin LANGUAGES C)
list(PREPEND CMAKE_MODULE_PATH "${ENGINE}/tests/source-resolution/cmake")
set(AROS_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
set(AROS_TARGET_CPU x86_64)
set(AROS_TARGET_PLATFORM pc)
file(MAKE_DIRECTORY "${AROS_SOURCE_DIR}/compiler/startup" "${AROS_SOURCE_DIR}/module")
file(WRITE "${AROS_SOURCE_DIR}/compiler/startup/startup.c" "int startup_fixture;\n")
file(WRITE "${AROS_SOURCE_DIR}/compiler/startup/detach.c" "int detach_fixture;\n")
include("${ENGINE}/AROS.cmake")
# No generator process or SDK build is executed. Exercise the actual producer's
# configure-time manifest/custom-command declarations with a known host path.
set(AROS_HOST_GENMODULE "${CMAKE_COMMAND}")
set(_config "${AROS_SOURCE_DIR}/module/Probe.conf")
set(_override "${AROS_SOURCE_DIR}/module/Probe.override")
file(WRITE "${_config}" "##begin config\nversion 1.0\n##end config\n##begin functionlist\nvoid ProbeFunction(void) (D0)\n##end functionlist\n")
file(WRITE "${_override}" "##begin config\noptions rellinklib\n##end config\n")
aros_set_module_config(probe-owner "${_config}")
if(CASE MATCHES "no-override$")
    set(_override "")
else()
    aros_set_module_config_override(probe-owner "${_override}")
endif()
if(CASE MATCHES "^ambient")
    set(OWNER "caller-owner")
    set(DECLARATION "caller-declaration")
    set(CONFIG "caller-config")
    set(OVERRIDE "caller-override")
endif()
_aros_generate_module_support(_generated TARGET Probe MMAKE_ID probe-owner
    DIRECTORY "${AROS_SOURCE_DIR}/module" MODTYPE library)
if(CASE STREQUAL "conflicting-producer")
    _aros_register_genmodule_sources(other-owner "${AROS_SOURCE_DIR}/module"
        "${_config}" "${_override}" "${_generated_GEN_DIR}"
        "${_generated_ROOT}/linklib" "${_generated_START}")
endif()
if(CASE STREQUAL "changed-config")
    file(APPEND "${_config}" "# changed after registration\n")
elseif(CASE STREQUAL "changed-override")
    file(APPEND "${_override}" "# changed after registration\n")
endif()
set(_owner probe-owner)
set(_selected "${_generated_START}")
if(CASE STREQUAL "wrong-owner")
    set(_owner other-owner)
elseif(CASE STREQUAL "invented-output")
    set(_selected "${_generated_GEN_DIR}/Probe_invented.c")
elseif(CASE STREQUAL "entrypoints")
    set(_selected "${_generated_ENTRYPOINTS}")
endif()
_aros_genmodule_source_origin(_origin "${_selected}" "${_owner}")
if(NOT _origin_OWNER STREQUAL "probe-owner" OR
   NOT _origin_DECLARATION STREQUAL "${AROS_SOURCE_DIR}/module" OR
   NOT _origin_CONFIG STREQUAL _config OR NOT _origin_OVERRIDE STREQUAL _override OR
   NOT _origin_LANE STREQUAL GEN OR NOT _origin_NAME STREQUAL "Probe_start.c")
    message(FATAL_ERROR "actual genmodule origin lost declaration or source identity")
endif()
if(EXISTS "${_selected}")
    message(FATAL_ERROR "cold producer fixture unexpectedly generated a C source")
endif()
set(_count 0)
foreach(_source IN LISTS _generated_NORMAL_LINKLIB_SOURCES _generated_REL_LINKLIB_SOURCES)
    _aros_genmodule_source_origin(_stub "${_source}" probe-owner)
    get_filename_component(_name "${_source}" NAME)
    if(NOT _stub_LANE STREQUAL LINKLIB OR NOT _stub_NAME STREQUAL _name)
        message(FATAL_ERROR "normal/relative genmodule stub lost exact manifest identity")
    endif()
    math(EXPR _count "${_count} + 1")
endforeach()
if(CASE MATCHES "no-override$")
    if(_count LESS 2 OR _generated_REL_LINKLIB_SOURCES)
        message(FATAL_ERROR "no-override producer changed its normal/relative source selection")
    endif()
elseif(_count LESS 4 OR NOT _generated_REL_LINKLIB_SOURCES)
    message(FATAL_ERROR "fixture did not cover both normal and relative generated sources")
endif()
set(_make_gen "/measured/build/bin/target/gen")
set(_make_obj "${_make_gen}/workbench/libs/mesa/26.0.0")
set(_declaration "${AROS_SOURCE_DIR}/module")
add_library(selected OBJECT EXCLUDE_FROM_ALL "${_generated_START}" "${_generated_END}"
    ${_generated_NORMAL_LINKLIB_SOURCES} ${_generated_REL_LINKLIB_SOURCES})
add_library(ordinary OBJECT EXCLUDE_FROM_ALL "${_generated_START}")
if(CASE STREQUAL "mismatched-declaration")
    set(_declaration "${AROS_SOURCE_DIR}/compiler")
elseif(CASE STREQUAL "outside-make-root")
    set(_make_obj "/outside/object-root")
elseif(CASE STREQUAL "unknown-lane")
    string(SHA256 _key "${_generated_START}")
    set_property(GLOBAL PROPERTY "AROS_GENMODULE_SOURCE_${_key}_LANE" UNKNOWN)
elseif(CASE STREQUAL "unregistered-target-output")
    set(_invented "${_generated_GEN_DIR}/invented.c")
    set_source_files_properties("${_invented}" PROPERTIES GENERATED TRUE)
    target_sources(selected PRIVATE "${_invented}")
endif()
_aros_bind_mesa_genmodule_context(selected probe-owner "${_declaration}" "${_make_obj}" "${_make_gen}")
if(CASE STREQUAL "rebound-context")
    set(_make_obj "${_make_gen}/another-object-root")
endif()
# Identical repeat binding is idempotent; changed context must refuse.
_aros_bind_mesa_genmodule_context(selected probe-owner "${_declaration}" "${_make_obj}" "${_make_gen}")
get_target_property(_bound selected AROS_MESA_GENMODULE_BOUND_SOURCES)
list(LENGTH _bound _bound_count)
math(EXPR _expected_count "${_count} + 2")
if(NOT _bound_count EQUAL _expected_count)
    message(FATAL_ERROR "concrete target lost an exact generated source binding")
endif()
foreach(_path IN LISTS _bound)
    string(SHA256 _binding "selected|${_path}")
    get_property(_nominal GLOBAL PROPERTY "AROS_MESA_GENMODULE_NOMINAL_${_binding}")
    get_filename_component(_name "${_path}" NAME)
    if(_path STREQUAL _generated_START OR _path STREQUAL _generated_END)
        set(_expected "${_make_obj}/${_name}")
    else()
        set(_expected "${_make_obj}/linklib/${_name}")
    endif()
    if(NOT _nominal STREQUAL _expected)
        message(FATAL_ERROR "exact manifest lane did not join source-evaluated Make OBJDIR")
    endif()
    string(SHA256 _ordinary_binding "ordinary|${_path}")
    get_property(_leaked GLOBAL PROPERTY "AROS_MESA_GENMODULE_NOMINAL_${_ordinary_binding}" SET)
    if(_leaked)
        message(FATAL_ERROR "nominal binding leaked to an ordinary target")
    endif()
endforeach()
]=])
foreach(_case IN ITEMS good good-no-override ambient ambient-no-override
        changed-config changed-override wrong-owner invented-output entrypoints conflicting-producer
        mismatched-declaration outside-make-root unknown-lane unregistered-target-output rebound-context)
    execute_process(COMMAND "${CMAKE_COMMAND}" -G Ninja -S "${_root}/source"
        -B "${_root}/${_case}" "-DENGINE=${_engine}" "-DCASE=${_case}"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(_case MATCHES "^(good|ambient)")
        if(NOT _status EQUAL 0)
            message(FATAL_ERROR "actual genmodule producer fixture failed: ${_out}${_err}")
        endif()
    else()
        if(_case STREQUAL "mismatched-declaration")
            set(_reason "belongs to a different declaration")
        elseif(_case STREQUAL "outside-make-root")
            set(_reason "leaves measured GENDIR")
        elseif(_case STREQUAL "unknown-lane")
            set(_reason "no measured output lane")
        elseif(_case STREQUAL "unregistered-target-output")
            set(_reason "unregistered genmodule source")
        elseif(_case STREQUAL "rebound-context")
            set(_reason "changed after binding")
        elseif(_case STREQUAL "conflicting-producer")
            set(_reason "conflicting producer metadata")
        elseif(_case MATCHES "^changed")
            set(_reason "genmodule source declaration input changed")
        else()
            set(_reason "no matching genmodule owner")
        endif()
        if(_status EQUAL 0 OR NOT "${_out}${_err}" MATCHES "${_reason}")
            message(FATAL_ERROR "genmodule origin ${_case} missed expected refusal: ${_out}${_err}")
        endif()
    endif()
endforeach()
