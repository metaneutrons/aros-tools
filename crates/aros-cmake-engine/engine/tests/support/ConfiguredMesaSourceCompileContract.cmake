include_guard(GLOBAL)

# Test support for the closed Mesa source compile contract. Production callers
# must use measured recipe data from the source evaluator.

# Select only from the origin set retained by the engine's actual proxy
# producer. Candidate absence/ambiguity must be resolved before activation;
# choosing whichever existing file happens to be listed first is not binding.
function(_aros_mesa_proxy_original out_var proxy)
    if(NOT IS_ABSOLUTE "${proxy}" OR NOT EXISTS "${proxy}" OR
       IS_DIRECTORY "${proxy}" OR IS_SYMLINK "${proxy}")
        message(FATAL_ERROR "Mesa proxy requires its original regular output")
    endif()
    string(SHA256 _key "${proxy}")
    get_property(_candidates GLOBAL PROPERTY "AROS_PORT_SOURCE_CANDIDATES_${_key}")
    get_property(_expected_body GLOBAL PROPERTY "AROS_PORT_SOURCE_BODY_${_key}")
    if(NOT _candidates OR NOT _expected_body)
        message(FATAL_ERROR "Mesa proxy has no registered source producer")
    endif()
    file(SHA256 "${proxy}" _body)
    if(NOT _body STREQUAL _expected_body)
        message(FATAL_ERROR "Mesa proxy changed after producer registration")
    endif()
    set(_selected "")
    foreach(_candidate IN LISTS _candidates)
        if(IS_SYMLINK "${_candidate}")
            message(FATAL_ERROR "Mesa proxy source candidate is an undeclared symlink")
        endif()
        if(EXISTS "${_candidate}" AND NOT IS_DIRECTORY "${_candidate}")
            file(REAL_PATH "${_candidate}" _canonical)
            if(NOT _canonical STREQUAL _candidate)
                message(FATAL_ERROR "Mesa proxy source candidate has a symlinked ancestor")
            endif()
            list(APPEND _selected "${_candidate}")
        endif()
    endforeach()
    list(LENGTH _selected _count)
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "Mesa proxy requires exactly one selected original source, got ${_count}")
    endif()
    list(GET _selected 0 _original)
    set(${out_var} "${_original}" PARENT_SCOPE)
endfunction()

# Apply one already source-bound compile_q context. The caller must provide
# the original Make source, never infer its identity from a generated proxy.
# This primitive does not select sources, authenticate their owner or replace
# the source evaluator's recipe/fingerprint checks.
function(_aros_mesa_source_compile_contract target source original declaration language
        make_original make_source make_build quote_extra)
    if(NOT TARGET "${target}" OR NOT target MATCHES "^[A-Za-z0-9_.+-]+$")
        message(FATAL_ERROR "Mesa source contract requires a concrete safe target")
    endif()
    if(NOT language MATCHES "^(C|CXX)$")
        message(FATAL_ERROR "Mesa source contract requires C or CXX")
    endif()
    get_target_property(_target_options "${target}" COMPILE_OPTIONS)
    if(_target_options)
        message(FATAL_ERROR "Mesa source contract rejects preceding target options")
    endif()
    foreach(_name IN ITEMS source original declaration AROS_SOURCE_DIR AROS_BUILD_DIR
            make_original make_source make_build quote_extra)
        set(_path "${${_name}}")
        if(NOT IS_ABSOLUTE "${_path}" OR _path MATCHES "[;\r\n$<>\"\\\\]")
            message(FATAL_ERROR "Mesa source contract requires safe absolute paths")
        endif()
        cmake_path(NORMAL_PATH _path OUTPUT_VARIABLE _normal)
        if(NOT _normal STREQUAL _path)
            message(FATAL_ERROR "Mesa source contract rejects nonnormalized paths")
        endif()
    endforeach()
    set(_proxy_root "${CMAKE_BINARY_DIR}/CMakeFiles/aros-port-sources")
    cmake_path(IS_PREFIX _proxy_root "${source}" NORMALIZE _is_proxy)
    if(_is_proxy)
        _aros_mesa_proxy_original(_registered_original "${source}")
        if(NOT original STREQUAL _registered_original)
            message(FATAL_ERROR "Mesa source contract original differs from registered proxy selection")
        endif()
        get_source_file_property(_proxy_language "${source}" TARGET_DIRECTORY "${target}" LANGUAGE)
        if(NOT _proxy_language STREQUAL language)
            message(FATAL_ERROR "Mesa source contract language differs from the actual source")
        endif()
        get_source_file_property(_header_only "${source}" TARGET_DIRECTORY "${target}" HEADER_FILE_ONLY)
        if(_header_only AND NOT _header_only STREQUAL "NOTFOUND")
            message(FATAL_ERROR "Mesa proxy is not a compilable source")
        endif()
        get_source_file_property(_object_dependencies "${source}" TARGET_DIRECTORY "${target}" OBJECT_DEPENDS)
        # A legacy proxy may select a different __has_include branch after
        # configure. Freeze this target's selected original into its own
        # single-include proxy; keep ordinary targets on the legacy producer.
        foreach(_property IN ITEMS COMPILE_OPTIONS COMPILE_FLAGS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
            get_source_file_property(_prior "${source}" TARGET_DIRECTORY "${target}" "${_property}")
            if(_prior AND NOT _prior STREQUAL "NOTFOUND")
                message(FATAL_ERROR "Mesa proxy has unmeasured source properties before freezing")
            endif()
        endforeach()
        get_target_property(_target_sources "${target}" SOURCES)
        if(NOT source IN_LIST _target_sources)
            message(FATAL_ERROR "Mesa source contract source is not owned by target")
        endif()
        string(SHA256 _frozen_key "${target}|${source}|${original}|${language}")
        set(_frozen_dir "${CMAKE_BINARY_DIR}/CMakeFiles/aros-mesa-sources")
        if(IS_SYMLINK "${CMAKE_BINARY_DIR}/CMakeFiles" OR IS_SYMLINK "${_frozen_dir}")
            message(FATAL_ERROR "Mesa frozen proxy directory is a symlink")
        endif()
        file(MAKE_DIRECTORY "${_frozen_dir}")
        if(language STREQUAL "CXX")
            set(_suffix cpp)
        else()
            set(_suffix c)
        endif()
        set(_frozen "${_frozen_dir}/${_frozen_key}.${_suffix}")
        if(IS_SYMLINK "${_frozen}" OR IS_DIRECTORY "${_frozen}")
            message(FATAL_ERROR "Mesa frozen proxy output is not a regular owned path")
        endif()
        set(_body "/* Frozen configured Mesa source; do not edit. */\n#include \"${original}\"\n")
        set(_existing "")
        if(EXISTS "${_frozen}")
            file(READ "${_frozen}" _existing)
        endif()
        if(NOT _existing STREQUAL _body)
            file(WRITE "${_frozen}" "${_body}")
        endif()
        set(_replaced "")
        set(_count 0)
        foreach(_entry IN LISTS _target_sources)
            if(_entry STREQUAL source)
                list(APPEND _replaced "${_frozen}")
                math(EXPR _count "${_count} + 1")
            else()
                list(APPEND _replaced "${_entry}")
            endif()
        endforeach()
        if(NOT _count EQUAL 1)
            message(FATAL_ERROR "Mesa frozen proxy requires one target source occurrence")
        endif()
        set_property(TARGET "${target}" PROPERTY SOURCES "${_replaced}")
        string(SHA256 _old_stem_key "${source}")
        string(SHA256 _new_stem_key "${_frozen}")
        get_property(_stem GLOBAL PROPERTY "AROS_SOURCE_OBJECT_STEM_${_old_stem_key}")
        set_property(GLOBAL PROPERTY "AROS_SOURCE_OBJECT_STEM_${_new_stem_key}" "${_stem}")
        set_property(GLOBAL PROPERTY "AROS_MESA_FROZEN_ORIGINAL_${_new_stem_key}" "${original}")
        set(source "${_frozen}")
        set_source_files_properties("${source}" TARGET_DIRECTORY "${target}" PROPERTIES LANGUAGE "${language}")
        if(_object_dependencies AND NOT _object_dependencies STREQUAL "NOTFOUND")
            set_source_files_properties("${source}" TARGET_DIRECTORY "${target}" PROPERTIES
                OBJECT_DEPENDS "${_object_dependencies}")
        endif()
    endif()
    cmake_path(IS_PREFIX AROS_SOURCE_DIR "${declaration}" NORMALIZE _inside)
    if(NOT _inside)
        message(FATAL_ERROR "Mesa source declaration leaves the selected source")
    endif()
    get_target_property(_sources "${target}" SOURCES)
    if(NOT source IN_LIST _sources)
        message(FATAL_ERROR "Mesa source contract source is not owned by target")
    endif()
    string(SHA256 _key "${target}|${source}")
    get_property(_bound GLOBAL PROPERTY "AROS_MESA_SOURCE_CONTRACT_${_key}")
    if(_bound)
        message(FATAL_ERROR "Mesa source contract cannot be applied twice")
    endif()
    get_source_file_property(_language "${source}" TARGET_DIRECTORY "${target}" LANGUAGE)
    if(NOT _language STREQUAL language)
        message(FATAL_ERROR "Mesa source contract language differs from the actual source")
    endif()
    get_target_property(_source_scope "${target}" SOURCE_DIR)
    string(SHA256 _source_key "${_source_scope}|${source}")
    get_property(_owned_options GLOBAL PROPERTY "AROS_MESA_SOURCE_OPTIONS_${_source_key}")
    get_property(_options_set SOURCE "${source}" TARGET_DIRECTORY "${target}"
        PROPERTY COMPILE_OPTIONS SET)
    if(_options_set)
        get_source_file_property(_current_options "${source}" TARGET_DIRECTORY "${target}" COMPILE_OPTIONS)
        if(NOT "${_current_options}" STREQUAL "${_owned_options}")
            message(FATAL_ERROR "Mesa source contract rejects unmeasured existing source options")
        endif()
    elseif(_owned_options)
        message(FATAL_ERROR "Mesa source contract detects removed owned source options")
    endif()
    cmake_path(GET original PARENT_PATH _source_directory)
    # GNU Make's nested subst removes SRCDIR/ first, then TOP/. Its nominal
    # coordinates must stay distinct from productive CMake layout: the latter
    # can be inside the source tree while the measured Make owner is outside.
    # The caller must bind this mapping, not guess nominal roots from a proxy.
    string(REPLACE "${make_source}/" "" _logical "${make_original}")
    string(REPLACE "${make_build}/" "" _logical "${_logical}")
    # incextra differs by recipe: linklibs default to TOP/CURDIR, full
    # modules to its parent, and explicit source declarations can override it.
    # Require the caller's evaluated path rather than guessing one default.
    set(_options -iquote "${_source_directory}" -iquote "${quote_extra}"
        -iquote "${declaration}" -iquote "${AROS_BUILD_DIR}")
    math(EXPR _last "${ARGC} - 1")
    if(_last LESS 9)
        message(FATAL_ERROR "Mesa source contract requires complete language options")
    endif()
    foreach(_index RANGE 9 ${_last})
        set(_argument "${ARGV${_index}}")
        if(_argument STREQUAL "" OR _argument MATCHES "[;\r\n$<>]" OR _argument MATCHES "^@")
            message(FATAL_ERROR "Mesa source contract contains an unsafe option")
        endif()
        list(APPEND _options "${_argument}")
    endforeach()
    list(APPEND _options "-D__SRCFILENAME__=\"${_logical}\"")
    # Source properties are directory-scoped, not target-scoped. Guard every
    # argument so compiling this same file in another target cannot inherit it.
    # Source COMPILE_OPTIONS keeps raw argv entries and repeated words; unlike
    # target options it must not contain a SHELL: group.
    foreach(_option IN LISTS _options)
        set_property(SOURCE "${source}" TARGET_DIRECTORY "${target}" APPEND PROPERTY
            COMPILE_OPTIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,${target}>:${_option}>")
    endforeach()
    get_source_file_property(_owned_options "${source}" TARGET_DIRECTORY "${target}" COMPILE_OPTIONS)
    set_property(GLOBAL PROPERTY "AROS_MESA_SOURCE_OPTIONS_${_source_key}" "${_owned_options}")
    set_property(GLOBAL PROPERTY "AROS_MESA_SOURCE_CONTRACT_${_key}" TRUE)
endfunction()
