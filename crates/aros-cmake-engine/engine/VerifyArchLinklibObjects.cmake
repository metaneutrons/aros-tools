cmake_minimum_required(VERSION 3.22)
if(NOT IS_ABSOLUTE "${CONTRACT}" OR IS_SYMLINK "${CONTRACT}" OR
   NOT EXISTS "${CONTRACT}" OR IS_DIRECTORY "${CONTRACT}")
    message(FATAL_ERROR "Architecture client-linklib: invalid generated object contract")
endif()
include("${CONTRACT}")
if(NOT EXPECTED_OBJECT_SETS MATCHES "^[1-9][0-9]*$" OR EXPECTED_OBJECT_SETS GREATER 8192)
    message(FATAL_ERROR "Architecture client-linklib: object set exceeds its closed bound")
endif()
find_program(regular_file_test NAMES test PATHS /usr/bin /bin NO_DEFAULT_PATH REQUIRED)
math(EXPR last "${EXPECTED_OBJECT_SETS} - 1")
set(seen)
foreach(index RANGE 0 ${last})
    list(LENGTH OBJECT_SET_${index} count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Architecture client-linklib: selected source has no unique compiler object")
    endif()
    list(GET OBJECT_SET_${index} 0 object)
    if(NOT IS_ABSOLUTE "${object}" OR IS_SYMLINK "${object}")
        message(FATAL_ERROR "Architecture client-linklib: unsafe compiler object")
    endif()
    execute_process(COMMAND "${regular_file_test}" -f "${object}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Architecture client-linklib: compiler object is missing or nonregular")
    endif()
    string(TOLOWER "${object}" folded)
    if(folded IN_LIST seen)
        message(FATAL_ERROR "Architecture client-linklib: compiler objects collide")
    endif()
    list(APPEND seen "${folded}")
endforeach()
