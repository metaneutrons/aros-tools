include_guard(GLOBAL)

# Join an exact generated-C producer record with the source-evaluated Make
# object directory. Engine genmodule layout is deliberately not prefix-mapped:
# GEN products belong directly to Make OBJDIR; LINKLIB products to its linklib
# child. This records nominal identity, not completed generator execution.
function(_aros_mesa_genmodule_nominal_source out_var source owner declaration make_objdir make_gendir)
    foreach(_path IN ITEMS "${source}" "${declaration}" "${make_objdir}" "${make_gendir}")
        if(NOT IS_ABSOLUTE "${_path}" OR _path MATCHES "[;\r\n$<>\"\\\\]")
            message(FATAL_ERROR "Mesa genmodule binding requires safe absolute paths")
        endif()
        cmake_path(NORMAL_PATH _path OUTPUT_VARIABLE _normal)
        if(NOT "${_normal}" STREQUAL "${_path}")
            message(FATAL_ERROR "Mesa genmodule binding rejects nonnormalized paths")
        endif()
    endforeach()
    cmake_path(IS_PREFIX AROS_SOURCE_DIR "${declaration}" NORMALIZE _declaration_inside)
    if(NOT _declaration_inside OR NOT IS_DIRECTORY "${declaration}")
        message(FATAL_ERROR "Mesa genmodule declaration leaves selected source")
    endif()
    cmake_path(IS_PREFIX make_gendir "${make_objdir}" NORMALIZE _inside)
    if(NOT _inside OR "${make_objdir}" STREQUAL "${make_gendir}")
        message(FATAL_ERROR "Mesa genmodule object directory leaves measured GENDIR")
    endif()
    _aros_genmodule_source_origin(_origin "${source}" "${owner}")
    if(NOT "${_origin_DECLARATION}" STREQUAL "${declaration}")
        message(FATAL_ERROR "Mesa genmodule source belongs to a different declaration")
    endif()
    if(NOT _origin_NAME MATCHES "^[A-Za-z0-9_.+-]+[.]c$" OR _origin_NAME MATCHES "[.][.]")
        message(FATAL_ERROR "Mesa genmodule source has an unsafe manifest name")
    endif()
    if("${_origin_LANE}" STREQUAL "GEN")
        set(_nominal "${make_objdir}/${_origin_NAME}")
    elseif("${_origin_LANE}" STREQUAL "LINKLIB")
        set(_nominal "${make_objdir}/linklib/${_origin_NAME}")
    else()
        message(FATAL_ERROR "Mesa genmodule source has no measured output lane")
    endif()
    set(${out_var} "${_nominal}" PARENT_SCOPE)
endfunction()

# Bind only exact genmodule sources on this concrete target. Other source
# families need their own producer join before complete per-source activation.
# No compile options are changed by this metadata step.
function(_aros_bind_mesa_genmodule_context target owner declaration make_objdir make_gendir)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Mesa genmodule context requires a concrete target")
    endif()
    get_target_property(_sources "${target}" SOURCES)
    get_target_property(_source_dir "${target}" SOURCE_DIR)
    set(_genmodule_root "${CMAKE_BINARY_DIR}/genmodule")
    set(_bound "")
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "^[$]<")
            continue()
        endif()
        cmake_path(ABSOLUTE_PATH _source BASE_DIRECTORY "${_source_dir}"
            NORMALIZE OUTPUT_VARIABLE _absolute)
        string(SHA256 _key "${_absolute}")
        get_property(_registered GLOBAL PROPERTY "AROS_GENMODULE_SOURCE_${_key}_OWNER" SET)
        if(NOT _registered)
            cmake_path(IS_PREFIX _genmodule_root "${_absolute}" NORMALIZE _under_genmodule)
            if(_under_genmodule AND _absolute MATCHES "[.](c|cc|cpp|cxx)$")
                message(FATAL_ERROR "Mesa target names an unregistered genmodule source")
            endif()
            continue()
        endif()
        _aros_mesa_genmodule_nominal_source(_nominal "${_absolute}" "${owner}"
            "${declaration}" "${make_objdir}" "${make_gendir}")
        string(SHA256 _binding_key "${target}|${_absolute}")
        get_property(_prior GLOBAL PROPERTY "AROS_MESA_GENMODULE_NOMINAL_${_binding_key}")
        if(_prior AND NOT "${_prior}" STREQUAL "${_nominal}")
            message(FATAL_ERROR "Mesa target genmodule context was changed after binding")
        endif()
        set_property(GLOBAL PROPERTY "AROS_MESA_GENMODULE_NOMINAL_${_binding_key}" "${_nominal}")
        list(APPEND _bound "${_absolute}")
    endforeach()
    list(REMOVE_DUPLICATES _bound)
    set_property(TARGET "${target}" PROPERTY AROS_MESA_GENMODULE_BOUND_SOURCES "${_bound}")
endfunction()

# Bind fetched Python products only through their exact producer record. The
# nominal root comes from source top_builddir, never the engine's layout.
# This is declaration metadata, not proof of completed generator execution.
function(_aros_bind_mesa_python_context target owner build_root make_root make_gendir)
    if(NOT TARGET "${target}" OR NOT TARGET "${owner}")
        message(FATAL_ERROR "Mesa Python binding requires concrete target and producer")
    endif()
    # Match the actual producer's documented relative BUILD_ROOT semantics.
    # The exact retained absolute root is still required below.
    if("${build_root}" MATCHES "[;\r\n$<>\"\\\\]")
        message(FATAL_ERROR "Mesa Python binding requires safe absolute paths")
    endif()
    cmake_path(ABSOLUTE_PATH build_root BASE_DIRECTORY "${CMAKE_BINARY_DIR}/gen"
        NORMALIZE)
    foreach(_path IN ITEMS "${build_root}" "${make_root}" "${make_gendir}")
        if(NOT IS_ABSOLUTE "${_path}" OR _path MATCHES "[;\r\n$<>\"\\\\]")
            message(FATAL_ERROR "Mesa Python binding requires safe absolute paths")
        endif()
        cmake_path(NORMAL_PATH _path OUTPUT_VARIABLE _normal)
        if(NOT "${_normal}" STREQUAL "${_path}")
            message(FATAL_ERROR "Mesa Python binding rejects nonnormalized paths")
        endif()
    endforeach()
    cmake_path(IS_PREFIX make_gendir "${make_root}" NORMALIZE _inside)
    if(NOT _inside OR "${make_root}" STREQUAL "${make_gendir}")
        message(FATAL_ERROR "Mesa Python nominal root leaves measured GENDIR")
    endif()
    get_target_property(_outputs "${owner}" AROS_PYTHON_OUTPUTS)
    get_target_property(_is_owner "${owner}" AROS_PYTHON_OUTPUT_OWNER)
    if(NOT _is_owner OR NOT _outputs)
        message(FATAL_ERROR "Mesa Python source has a different or missing producer")
    endif()
    get_target_property(_sources "${target}" SOURCES)
    get_target_property(_source_dir "${target}" SOURCE_DIR)
    get_target_property(_bound "${target}" AROS_MESA_PYTHON_BOUND_SOURCES)
    if(NOT _bound)
        set(_bound "")
    endif()
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "^[$]<")
            continue()
        endif()
        cmake_path(ABSOLUTE_PATH _source BASE_DIRECTORY "${_source_dir}"
            NORMALIZE OUTPUT_VARIABLE _absolute)
        cmake_path(IS_PREFIX build_root "${_absolute}" NORMALIZE _under_root)
        if(NOT _under_root OR NOT _absolute MATCHES "[.](c|cc|cpp|cxx)$")
            continue()
        endif()
        string(SHA256 _key "${_absolute}")
        get_property(_actual_owner GLOBAL PROPERTY "AROS_PYTHON_OUTPUT_OWNER_${_key}")
        get_property(_actual_root GLOBAL PROPERTY "AROS_PYTHON_OUTPUT_BUILD_ROOT_${_key}")
        get_property(_relative GLOBAL PROPERTY "AROS_PYTHON_OUTPUT_RELATIVE_${_key}")
        if(NOT _actual_owner OR NOT TARGET "${_actual_owner}")
            message(FATAL_ERROR "Mesa Python source has a different or missing producer")
        endif()
        get_target_property(_actual_outputs "${_actual_owner}" AROS_PYTHON_OUTPUTS)
        get_target_property(_actual_is_owner "${_actual_owner}" AROS_PYTHON_OUTPUT_OWNER)
        if(NOT _actual_is_owner OR NOT _absolute IN_LIST _actual_outputs)
            message(FATAL_ERROR "Mesa Python source has a different or missing producer")
        endif()
        if(NOT "${_actual_root}" STREQUAL "${build_root}" OR
           NOT _relative OR IS_ABSOLUTE "${_relative}" OR
           _relative MATCHES "[;\r\n$<>\"\\\\]" OR
           _relative MATCHES "(^|/)[.][.]?(/|$)" OR
           NOT "${build_root}/${_relative}" STREQUAL "${_absolute}")
            message(FATAL_ERROR "Mesa Python source has inconsistent producer coordinates")
        endif()
        # Several audited producers share Mesa's top_builddir and a consumer.
        # Bind only this owner's exact outputs; the other owner is separately
        # emitted from its explicit consumer declaration, never guessed here.
        if(NOT "${_actual_owner}" STREQUAL "${owner}")
            continue()
        endif()
        if(NOT _absolute IN_LIST _outputs)
            message(FATAL_ERROR "Mesa Python source has a different or missing producer")
        endif()
        set(_nominal "${make_root}/${_relative}")
        string(SHA256 _binding "${target}|${_absolute}")
        get_property(_prior GLOBAL PROPERTY "AROS_MESA_PYTHON_NOMINAL_${_binding}")
        if(_prior AND NOT "${_prior}" STREQUAL "${_nominal}")
            message(FATAL_ERROR "Mesa Python context changed after binding")
        endif()
        set_property(GLOBAL PROPERTY "AROS_MESA_PYTHON_NOMINAL_${_binding}" "${_nominal}")
        list(APPEND _bound "${_absolute}")
    endforeach()
    list(REMOVE_DUPLICATES _bound)
    set_property(TARGET "${target}" PROPERTY AROS_MESA_PYTHON_BOUND_SOURCES "${_bound}")
endfunction()
