cmake_minimum_required(VERSION 3.22)
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/SourceValueRules.cmake")

# Source recipes supply finite data, not commands. The payload is read as text,
# never included as CMake code; both source and payload are checked at build time.
function(aros_write_source_literal_text)
    set(_keywords NAME OUTPUT FILE FILE_SHA256 TEXT)
    if(NOT ARGC EQUAL 10)
        message(FATAL_ERROR "literal text requires five unique keyword/value pairs")
    endif()
    set(_seen)
    foreach(_index RANGE 0 8 2)
        set(_key_variable "ARGV${_index}")
        set(_key "${${_key_variable}}")
        if(NOT _key IN_LIST _keywords OR _key IN_LIST _seen)
            message(FATAL_ERROR "literal text has an unknown or duplicate keyword: ${_key}")
        endif()
        math(EXPR _value_index "${_index} + 1")
        set(_value_variable "ARGV${_value_index}")
        set("LT_${_key}" "${${_value_variable}}")
        if("${LT_${_key}}" STREQUAL "")
            message(FATAL_ERROR "literal text ${_key} must not be empty")
        endif()
        list(APPEND _seen "${_key}")
    endforeach()
    if(NOT LT_NAME MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+-]*$" OR TARGET "${LT_NAME}")
        message(FATAL_ERROR "literal text NAME must be a unique safe target")
    endif()
    string(LENGTH "${LT_TEXT}" _text_size)
    if(_text_size LESS 1 OR _text_size GREATER 65536)
        message(FATAL_ERROR "literal text payload must contain 1-65536 bytes")
    endif()
    _aros_source_value_canonical_root("source root" "${AROS_SOURCE_DIR}" _source_root)
    _aros_source_value_canonical_root("binary root" "${CMAKE_BINARY_DIR}" _binary_root)
    _aros_literal_text_source_output("${_source_root}" "${LT_FILE}" "${LT_FILE_SHA256}"
        "${_binary_root}" "${LT_OUTPUT}" _source_file _output)
    string(SHA256 _key "${_output}")
    get_property(_previous GLOBAL PROPERTY "AROS_LITERAL_TEXT_OUTPUT_${_key}")
    if(_previous)
        message(FATAL_ERROR "literal text output already belongs to ${_previous}")
    endif()
    set(_private "${_binary_root}/.aros-source-literal-rules")
    _aros_source_value_check_components("literal payload root" "${_private}" "${_binary_root}")
    file(MAKE_DIRECTORY "${_private}")
    set(_payload "${_private}/${_key}.txt")
    _aros_literal_text_publish("${_payload}" "${LT_TEXT}" "${_binary_root}")
    file(SHA256 "${_payload}" _payload_hash)
    _aros_literal_text_source_output("${_source_root}" "${LT_FILE}" "${LT_FILE_SHA256}"
        "${_binary_root}" "${LT_OUTPUT}" _source_file _output)
    set(_runner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunSourceLiteralTextRule.cmake")
    add_custom_command(OUTPUT "${_output}"
        COMMAND "${CMAKE_COMMAND}"
            "-DBINARY_ROOT=${_binary_root}" "-DSOURCE_ROOT=${_source_root}"
            "-DFILE=${LT_FILE}" "-DFILE_SHA256=${LT_FILE_SHA256}"
            "-DOUTPUT=${_output}" "-DPAYLOAD=${_payload}" "-DPAYLOAD_SHA256=${_payload_hash}"
            -P "${_runner}"
        DEPENDS "${_source_file}" "${_payload}" "${_runner}"
            "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/SourceValueRules.cmake"
        VERBATIM)
    add_custom_target("${LT_NAME}" DEPENDS "${_output}")
    set_property(GLOBAL PROPERTY "AROS_LITERAL_TEXT_OUTPUT_${_key}" "${LT_NAME}")
endfunction()

function(_aros_literal_text_source_output source_root file file_sha binary_root output out_file out_output)
    _aros_source_value_validate_relative_path("literal declaring file" "${file}" _relative)
    get_filename_component(_basename "${_relative}" NAME)
    if(NOT _basename STREQUAL "mmakefile.src")
        message(FATAL_ERROR "literal text declaring file must be mmakefile.src")
    endif()
    _aros_source_value_validate_source_paths("${source_root}" "${source_root}/${_relative}"
        "${_relative}" "${file_sha}")
    get_filename_component(_directory "${_relative}" DIRECTORY)
    set(_output_root "${binary_root}/gen")
    if(NOT _directory STREQUAL "")
        string(APPEND _output_root "/${_directory}")
    endif()
    _aros_source_value_validate_absolute_path("literal output" "${output}" _output)
    get_filename_component(_parent "${_output}" DIRECTORY)
    get_filename_component(_output_name "${_output}" NAME)
    if(NOT _parent STREQUAL _output_root OR
       NOT _output_name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+-]*$")
        message(FATAL_ERROR "literal output must be one direct file below its declaring generated directory")
    endif()
    _aros_source_value_check_components("literal output" "${_output}" "${binary_root}")
    _aros_source_value_check_existing_output("literal output" "${_output}")
    set(${out_file} "${AROS_SOURCE_VALUE_VALIDATED_FILE}" PARENT_SCOPE)
    set(${out_output} "${_output}" PARENT_SCOPE)
endfunction()

function(_aros_literal_text_payload binary_root payload payload_sha out_text)
    _aros_source_value_validate_absolute_path("literal payload" "${payload}" _payload)
    _aros_source_value_require_descendant("literal payload" "${_payload}"
        "${binary_root}/.aros-source-literal-rules")
    _aros_source_value_check_components("literal payload" "${_payload}" "${binary_root}")
    _aros_source_value_require_regular_file("literal payload" "${_payload}")
    _aros_source_value_validate_sha256("literal payload SHA256" "${payload_sha}" _expected)
    file(SIZE "${_payload}" _size)
    if(_size LESS 1 OR _size GREATER 65536)
        message(FATAL_ERROR "literal payload exceeds its size bounds")
    endif()
    file(SHA256 "${_payload}" _before)
    file(READ "${_payload}" _text)
    file(SHA256 "${_payload}" _after)
    string(SHA256 _read_hash "${_text}")
    if(NOT _before STREQUAL _expected OR NOT _after STREQUAL _expected OR
       NOT _read_hash STREQUAL _expected)
        message(FATAL_ERROR "literal payload changed after configuration")
    endif()
    set(${out_text} "${_text}" PARENT_SCOPE)
endfunction()

# Replace the directory entry, not an existing inode, and preserve timestamps
# when bytes are unchanged. Existing symlinks/special files are never followed.
function(_aros_literal_text_publish output text binary_root)
    _aros_source_value_check_components("literal publication" "${output}" "${binary_root}")
    _aros_source_value_check_existing_output("literal publication" "${output}")
    _aros_source_value_path_exists("${output}" _exists)
    string(SHA256 _expected "${text}")
    set(_old_hash "")
    if(_exists)
        file(SHA256 "${output}" _old_hash)
        if(_old_hash STREQUAL _expected)
            return()
        endif()
    endif()
    get_filename_component(_parent "${output}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    _aros_source_value_check_components("literal publication parent" "${output}" "${binary_root}")
    string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef _nonce)
    set(_temporary "${output}.tmp-${_nonce}")
    _aros_source_value_path_exists("${_temporary}" _temporary_exists)
    if(_temporary_exists OR IS_SYMLINK "${_temporary}")
        message(FATAL_ERROR "literal temporary output already exists")
    endif()
    file(WRITE "${_temporary}" "${text}")
    _aros_source_value_require_regular_file("literal temporary output" "${_temporary}")
    file(SHA256 "${_temporary}" _temporary_hash)
    if(NOT _temporary_hash STREQUAL _expected)
        message(FATAL_ERROR "literal temporary output failed byte verification")
    endif()
    _aros_source_value_check_components("literal publication" "${output}" "${binary_root}")
    _aros_source_value_check_existing_output("literal publication" "${output}")
    _aros_source_value_path_exists("${output}" _now_exists)
    if(_exists)
        if(NOT _now_exists)
            message(FATAL_ERROR "literal output disappeared during publication")
        endif()
        file(SHA256 "${output}" _now_hash)
        if(NOT _now_hash STREQUAL _old_hash)
            message(FATAL_ERROR "literal output changed during publication")
        endif()
    elseif(_now_exists)
        message(FATAL_ERROR "literal output appeared during publication")
    endif()
    file(RENAME "${_temporary}" "${output}" RESULT _result)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "literal output atomic rename failed: ${_result}")
    endif()
    _aros_source_value_require_regular_file("published literal output" "${output}")
    file(SHA256 "${output}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "published literal output failed byte verification")
    endif()
endfunction()
