include_guard(GLOBAL)

# Bind source-measured command roles before configured Mesa declarations.
# This verifies executable spelling, not merely realpath: clang++ and clang
# may be symlinks to identical bytes but select different driver modes.
function(_aros_bind_mesa_compiler_roles expected_c expected_cxx triple nominal_build nominal_gen nominal_ports)
    if(NOT triple MATCHES "^[A-Za-z0-9_.+-]+$")
        message(FATAL_ERROR "Mesa compiler role requires an inert target triple")
    endif()
    foreach(_language IN ITEMS C CXX)
        if(_language STREQUAL "C")
            set(_expected "${expected_c}")
        else()
            set(_expected "${expected_cxx}")
        endif()
        if(NOT IS_ABSOLUTE "${_expected}" OR NOT EXISTS "${_expected}" OR
           IS_DIRECTORY "${_expected}" OR _expected MATCHES "[;\r\n$<>\"\\\\]")
            message(FATAL_ERROR "Mesa compiler role requires the selected driver path")
        endif()
        if(NOT "${CMAKE_${_language}_COMPILER}" STREQUAL "${_expected}")
            message(FATAL_ERROR "Mesa compiler differs from the measured source driver")
        endif()
        if(CMAKE_${_language}_COMPILER_ARG1)
            message(FATAL_ERROR "Mesa compiler has an unmeasured driver prefix")
        endif()
        if(CMAKE_${_language}_COMPILER_EXTERNAL_TOOLCHAIN)
            message(FATAL_ERROR "Mesa compiler has an unmeasured external toolchain")
        endif()
        if(CMAKE_${_language}_COMPILER_TARGET AND
           NOT "${CMAKE_${_language}_COMPILER_TARGET}" STREQUAL "${triple}")
            message(FATAL_ERROR "Mesa compiler target differs from selected identity")
        endif()
    endforeach()
    if(CMAKE_SYSROOT OR CMAKE_SYSROOT_COMPILE OR CMAKE_SYSROOT_LINK)
        message(FATAL_ERROR "Mesa compiler has an unmeasured automatic sysroot")
    endif()
    foreach(_path IN ITEMS "${nominal_build}" "${nominal_gen}" "${nominal_ports}")
        if(NOT IS_ABSOLUTE "${_path}" OR _path MATCHES "[;\r\n$<>\"\\\\]")
            message(FATAL_ERROR "Mesa compiler role requires safe nominal roots")
        endif()
        cmake_path(NORMAL_PATH _path OUTPUT_VARIABLE _normal)
        if(NOT "${_normal}" STREQUAL "${_path}")
            message(FATAL_ERROR "Mesa compiler role rejects nonnormalized roots")
        endif()
    endforeach()
    set(_sysroot_options "")
    if(ARGC GREATER 6)
        if(ARGC EQUAL 8 AND "${ARGV6}" STREQUAL "--sysroot")
            set(_nominal_sdk "${ARGV7}")
            set(_split TRUE)
        elseif(ARGC EQUAL 7 AND "${ARGV6}" MATCHES "^--sysroot=.+$")
            string(SUBSTRING "${ARGV6}" 10 -1 _nominal_sdk)
            set(_split FALSE)
        else()
            message(FATAL_ERROR "Mesa compiler role has an unmeasured sysroot shape")
        endif()
        if(NOT IS_ABSOLUTE "${_nominal_sdk}" OR _nominal_sdk MATCHES "[;\r\n$<>\"\\\\]")
            message(FATAL_ERROR "Mesa compiler sysroot requires an inert absolute path")
        endif()
        cmake_path(NORMAL_PATH _nominal_sdk OUTPUT_VARIABLE _normal)
        cmake_path(IS_PREFIX nominal_build "${_nominal_sdk}" NORMALIZE _inside)
        cmake_path(IS_PREFIX nominal_gen "${_nominal_sdk}" NORMALIZE _generated)
        cmake_path(IS_PREFIX nominal_ports "${_nominal_sdk}" NORMALIZE _ports)
        cmake_path(IS_PREFIX _nominal_sdk "${nominal_gen}" NORMALIZE _contains_generated)
        cmake_path(IS_PREFIX _nominal_sdk "${nominal_ports}" NORMALIZE _contains_ports)
        if(NOT "${_normal}" STREQUAL "${_nominal_sdk}" OR NOT _inside OR
           "${_nominal_sdk}" STREQUAL "${nominal_build}" OR _generated OR _ports OR
           _contains_generated OR _contains_ports)
            message(FATAL_ERROR "Mesa compiler sysroot is not a distinct measured SDK role")
        endif()
        # A staged SDK need not exist yet. Its productive location is the
        # engine's declared Developer role, not the private configure tree.
        foreach(_path IN ITEMS "${AROS_BUILD_DIR}" "${AROS_DEVELOPER_DIR}")
            if(NOT IS_ABSOLUTE "${_path}" OR _path MATCHES "[;\r\n$<>\"\\\\]")
                message(FATAL_ERROR "Mesa productive SDK requires safe absolute roles")
            endif()
            cmake_path(NORMAL_PATH _path OUTPUT_VARIABLE _normal)
            if(NOT "${_normal}" STREQUAL "${_path}")
                message(FATAL_ERROR "Mesa productive SDK rejects nonnormalized roles")
            endif()
        endforeach()
        if(NOT IS_ABSOLUTE "${AROS_DEVELOPER_DIR}" OR
           NOT "${AROS_TARGET_SYSROOT}" STREQUAL "${AROS_DEVELOPER_DIR}")
            message(FATAL_ERROR "Mesa productive sysroot differs from the SDK role")
        endif()
        cmake_path(IS_PREFIX AROS_BUILD_DIR "${AROS_DEVELOPER_DIR}" NORMALIZE _sdk_inside)
        if(NOT _sdk_inside OR "${AROS_DEVELOPER_DIR}" STREQUAL "${AROS_BUILD_DIR}")
            message(FATAL_ERROR "Mesa productive SDK leaves selected build")
        endif()
        if(_split)
            set(_sysroot_options "--sysroot" "${AROS_DEVELOPER_DIR}")
        else()
            set(_sysroot_options "--sysroot=${AROS_DEVELOPER_DIR}")
        endif()
    endif()
    # Source ISA options select the architecture explicitly where required.
    # Do not add CMake's independent target option to the measured command.
    set(CMAKE_C_COMPILER_TARGET "" PARENT_SCOPE)
    set(CMAKE_CXX_COMPILER_TARGET "" PARENT_SCOPE)
    set(_aros_mesa_sysroot_options "${_sysroot_options}" PARENT_SCOPE)
    set(_aros_mesa_driver_roles_bound TRUE PARENT_SCOPE)
endfunction()
