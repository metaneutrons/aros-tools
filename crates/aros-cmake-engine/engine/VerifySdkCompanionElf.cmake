# Byte-level ABI gate shared by fresh compilation and incremental staging.
function(verify_sdk_companion_elf path)
    if(NOT DEFINED EXPECTED_ELF_CLASS AND NOT DEFINED EXPECTED_ELF_MACHINE)
        return()
    endif()
    if(NOT EXPECTED_ELF_CLASS MATCHES "^[12]$" OR NOT EXPECTED_ELF_MACHINE MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "SDK companion: invalid ELF contract")
    endif()
    if(IS_SYMLINK "${path}" OR IS_DIRECTORY "${path}" OR NOT EXISTS "${path}")
        message(FATAL_ERROR "SDK companion: ELF must be a regular existing file")
    endif()
    file(READ "${path}" header OFFSET 0 LIMIT 20 HEX)
    string(LENGTH "${header}" length)
    if(NOT length EQUAL 40 OR NOT header MATCHES "^7f454c46")
        message(FATAL_ERROR "SDK companion: output is not ELF")
    endif()
    string(SUBSTRING "${header}" 8 2 class)
    string(SUBSTRING "${header}" 10 2 data)
    string(SUBSTRING "${header}" 32 4 type)
    string(SUBSTRING "${header}" 36 2 low)
    string(SUBSTRING "${header}" 38 2 high)
    math(EXPR machine "0x${high}${low}")
    if(NOT class STREQUAL "0${EXPECTED_ELF_CLASS}" OR NOT data STREQUAL "01" OR
       NOT type STREQUAL "0100" OR NOT machine EQUAL EXPECTED_ELF_MACHINE)
        message(FATAL_ERROR "SDK companion ELF class/endian/type/machine differs")
    endif()
endfunction()
