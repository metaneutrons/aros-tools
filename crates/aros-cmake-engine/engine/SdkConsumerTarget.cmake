# Target-generic SDK bindings remain separate from the legacy RISC-V ABI.
# Rust validates the sealed source/profile graph before project(). This module
# additionally requires explicit bootstrap facts for execution, and compares
# the configured LLVM drivers with that selection after compiler detection.
include_guard(GLOBAL)

function(_aros_validate_sdk_consumer_target json)
    _aros_native_require_type("${json}" "SDK consumer response" target OBJECT)
    string(JSON _target GET "${json}" target)
    _aros_native_require_object_members("${_target}" "SDK consumer target" "target_triple;abi")
    _aros_native_get_string(_triple "${_target}" "SDK consumer target" target_triple)
    _aros_native_validate_token("${_triple}" "SDK target triple")
    _aros_native_require_type("${_target}" "SDK consumer target" abi OBJECT)
    string(JSON _abi GET "${_target}" abi)
    string(JSON _count LENGTH "${_abi}")
    if(_count LESS 1 OR _count GREATER 32)
        _aros_native_consumer_fail("SDK ABI exceeds its closed scalar bounds")
    endif()
    set(_compiler_arch "")
    set(_compiler_cpu "")
    set(_compiler_fpu "")
    set(_compiler_code_model "")
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        string(JSON _key MEMBER "${_abi}" ${_index})
        _aros_native_validate_token("${_key}" "SDK ABI key")
        if(_key MATCHES "^(host|board|compiler)$")
            _aros_native_consumer_fail("SDK ABI cannot contain a host, board or compiler identity")
        endif()
        string(JSON _type TYPE "${_abi}" "${_key}")
        string(JSON _value GET "${_abi}" "${_key}")
        if(_key MATCHES "^(compiler_arch|compiler_cpu|compiler_fpu|compiler_code_model)$")
            _aros_native_get_string(_${_key} "${_abi}" "SDK target" "${_key}")
            string(LENGTH "${_${_key}}" _compiler_option_length)
            if(_compiler_option_length LESS 1 OR _compiler_option_length GREATER 64 OR
               NOT "${_${_key}}" MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+-]*$")
                _aros_native_contract_fail("SDK target ${_key}"
                    "must be 1..=64 ASCII characters, start with a letter or digit, and contain only letters, digits, _, ., + or -")
            endif()
        elseif(_type STREQUAL "STRING")
            _aros_native_validate_token("${_value}" "SDK ABI ${_key}")
        elseif(_type STREQUAL "NUMBER")
            if(NOT _value MATCHES "^[0-9]+$")
                _aros_native_consumer_fail("SDK ABI ${_key} must be an unsigned integer")
            endif()
        elseif(NOT _type STREQUAL "BOOLEAN")
            _aros_native_consumer_fail("SDK ABI ${_key} must be scalar")
        endif()
    endforeach()
    if(NOT _compiler_arch STREQUAL "" AND NOT _compiler_cpu STREQUAL "")
        _aros_native_consumer_fail(
            "SDK target compiler_arch and compiler_cpu are mutually exclusive")
    endif()
    foreach(_key IN ITEMS source_cpu flavour)
        _aros_native_get_string(_${_key} "${_abi}" "executable SDK ABI" "${_key}")
    endforeach()
    foreach(_key IN ITEMS platform_smp use_mmu)
        _aros_native_require_type("${_abi}" "executable SDK ABI" "${_key}" BOOLEAN)
        string(JSON _${_key} GET "${_abi}" "${_key}")
    endforeach()
    _aros_native_require_type("${_abi}" "executable SDK ABI" pointer_width NUMBER)
    string(JSON _pointer_width GET "${_abi}" pointer_width)
    if(NOT _pointer_width MATCHES "^(32|64)$")
        _aros_native_consumer_fail("SDK pointer width must be explicit 32 or 64")
    endif()
    # These optional code-generation choices belong to the source ABI. They
    # are intentionally not inferred from the generic triple, board, or CPU
    # selector.
    # A float ABI can be absent only if the source/caller selector is empty.
    string(JSON _float_type ERROR_VARIABLE _float_error TYPE "${_abi}" float_abi)
    if(_float_error STREQUAL "NOTFOUND")
        _aros_native_get_string(_float_abi "${_abi}" "executable SDK ABI" float_abi)
    else()
        set(_float_abi "")
    endif()
    if(AROS_TARGET_CPU STREQUAL "arm" AND
       NOT _float_abi MATCHES "^(hard|soft|softfp)$")
        _aros_native_consumer_fail(
            "ARM SDK target requires an explicit source float_abi of hard, soft, or softfp")
    endif()
    _aros_native_selector_boolean(_smp "${AROS_ABI_PLATFORM_SMP}" "AROS_ABI_PLATFORM_SMP")
    _aros_native_selector_boolean(_mmu "${AROS_ENABLE_MMU}" "AROS_ENABLE_MMU")
    if(NOT _source_cpu STREQUAL AROS_TARGET_CPU OR NOT _triple STREQUAL AROS_TARGET_TRIPLE OR
       NOT _float_abi STREQUAL GCC_CONFIG_FLOAT_ABI OR NOT _flavour STREQUAL AROS_ABI_FLAVOUR OR
       NOT _platform_smp STREQUAL _smp OR NOT _use_mmu STREQUAL _mmu)
        _aros_native_consumer_fail("source SDK target differs from the requested configuration")
    endif()
    set_property(GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_POINTER_WIDTH "${_pointer_width}")
    set_property(GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_ARCH "${_compiler_arch}")
    set_property(GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_CPU "${_compiler_cpu}")
    set_property(GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_FPU "${_compiler_fpu}")
    set_property(GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_CODE_MODEL "${_compiler_code_model}")
    set_property(GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_FLOAT_ABI "${_float_abi}")
endfunction()

function(_aros_sdk_count_compiler_options out_count out_exact out_split flags option_name value)
    separate_arguments(_flags UNIX_COMMAND "${flags}")
    set(_count 0)
    set(_exact 0)
    set(_split FALSE)
    set(_expected "-${option_name}=${value}")
    foreach(_flag IN LISTS _flags)
        if(_flag MATCHES "^-${option_name}")
            math(EXPR _count "${_count} + 1")
            if(_flag STREQUAL "-${option_name}")
                set(_split TRUE)
            elseif(NOT value STREQUAL "" AND _flag STREQUAL _expected)
                math(EXPR _exact "${_exact} + 1")
            endif()
        endif()
    endforeach()
    set(${out_count} "${_count}" PARENT_SCOPE)
    set(${out_exact} "${_exact}" PARENT_SCOPE)
    set(${out_split} "${_split}" PARENT_SCOPE)
endfunction()

function(_aros_sdk_reconcile_compiler_option out_flags flags language option_name fact_name value allow_append)
    _aros_sdk_count_compiler_options(_count _exact _split
        "${flags}" "${option_name}" "${value}")
    if(_split)
        _aros_native_consumer_fail(
            "${language} flags use split -${option_name} syntax; source SDK options must use -${option_name}=<value>")
    endif()
    if(value STREQUAL "")
        if(_count GREATER 0)
            _aros_native_consumer_fail(
                "${language} flags contain an undeclared -${option_name} option; SDK ABI.${fact_name} is absent")
        endif()
        set(${out_flags} "${flags}" PARENT_SCOPE)
        return()
    endif()
    if(_count EQUAL 0)
        if(NOT allow_append)
            _aros_native_consumer_fail(
                "${language} flags require exactly one selected -${option_name}=${value} option")
        endif()
        if(flags STREQUAL "")
            set(_updated "-${option_name}=${value}")
        else()
            set(_updated "${flags} -${option_name}=${value}")
        endif()
        set(${out_flags} "${_updated}" PARENT_SCOPE)
        return()
    endif()
    if(NOT _count EQUAL 1 OR NOT _exact EQUAL 1)
        _aros_native_consumer_fail(
            "${language} flags must contain exactly one selected -${option_name}=${value} option")
    endif()
    set(${out_flags} "${flags}" PARENT_SCOPE)
endfunction()

function(_aros_sdk_reconcile_float_abi out_flags flags language allow_append)
    get_property(_float_abi GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_FLOAT_ABI)
    separate_arguments(_flags UNIX_COMMAND "${flags}")
    set(_count 0)
    set(_exact 0)
    set(_split FALSE)
    foreach(_flag IN LISTS _flags)
        if(_flag MATCHES "^-mfloat-abi")
            math(EXPR _count "${_count} + 1")
            if(_flag STREQUAL "-mfloat-abi")
                set(_split TRUE)
            elseif(NOT _float_abi STREQUAL "" AND
                   _flag STREQUAL "-mfloat-abi=${_float_abi}")
                math(EXPR _exact "${_exact} + 1")
            endif()
        endif()
    endforeach()
    if(_split)
        _aros_native_consumer_fail(
            "${language} flags use split -mfloat-abi syntax; source SDK options must use -mfloat-abi=<value>")
    endif()
    if(_float_abi STREQUAL "")
        if(_count GREATER 0)
            _aros_native_consumer_fail(
                "${language} flags contain an undeclared -mfloat-abi option; SDK ABI.float_abi is absent")
        endif()
    elseif(_count EQUAL 0)
        if(NOT allow_append)
            _aros_native_consumer_fail(
                "${language} flags require exactly one selected -mfloat-abi=${_float_abi} option")
        endif()
        if(flags STREQUAL "")
            set(_updated "-mfloat-abi=${_float_abi}")
        else()
            set(_updated "${flags} -mfloat-abi=${_float_abi}")
        endif()
        set(${out_flags} "${_updated}" PARENT_SCOPE)
        return()
    elseif(NOT _count EQUAL 1 OR NOT _exact EQUAL 1)
        _aros_native_consumer_fail(
            "${language} flags must contain exactly one selected -mfloat-abi=${_float_abi} option")
    endif()
    set(${out_flags} "${flags}" PARENT_SCOPE)
endfunction()

function(_aros_sdk_reject_configuration_compiler_option language variable option_name fact_name value)
    if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
        return()
    endif()
    _aros_sdk_count_compiler_options(_count _exact _split
        "${${variable}}" "${option_name}" "${value}")
    if(_count GREATER 0)
        if(value STREQUAL "")
            _aros_native_consumer_fail(
                "${language} configuration flags contain undeclared -${option_name}; SDK ABI.${fact_name} is absent")
        endif()
        _aros_native_consumer_fail(
            "${language} per-configuration flags cannot override source-selected -${option_name}")
    endif()
endfunction()

function(_aros_sdk_reject_configuration_float_abi language variable)
    if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
        return()
    endif()
    separate_arguments(_flags UNIX_COMMAND "${${variable}}")
    foreach(_flag IN LISTS _flags)
        if(_flag MATCHES "^-mfloat-abi")
            _aros_native_consumer_fail(
                "${language} per-configuration flags cannot override source-selected float ABI")
        endif()
    endforeach()
endfunction()

function(_aros_sdk_reject_cpu_architecture_override language variable flags)
    get_property(_cpu GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_CPU)
    if(_cpu STREQUAL "")
        return()
    endif()
    separate_arguments(_flags UNIX_COMMAND "${flags}")
    foreach(_flag IN LISTS _flags)
        if(_flag MATCHES "^-march")
            _aros_native_consumer_fail(
                "${language} flags cannot override source-selected compiler_cpu with ${_flag}")
        endif()
    endforeach()
endfunction()

function(_aros_sdk_get_configuration_names out_configurations)
    set(_configurations DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    foreach(_configuration IN LISTS CMAKE_CONFIGURATION_TYPES)
        if(NOT "${_configuration}" STREQUAL "")
            string(TOUPPER "${_configuration}" _upper_configuration)
            list(APPEND _configurations "${_upper_configuration}")
        endif()
    endforeach()
    # Compiler ABI detection may select a configuration independently of the
    # project's build type. Its flags are part of the same sealed SDK boundary.
    foreach(_configuration IN ITEMS "${CMAKE_BUILD_TYPE}" "${CMAKE_BUILD_TYPE_INIT}"
            "${CMAKE_TRY_COMPILE_CONFIGURATION}")
        if(NOT "${_configuration}" STREQUAL "")
            string(TOUPPER "${_configuration}" _upper_configuration)
            list(APPEND _configurations "${_upper_configuration}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _configurations)
    set(${out_configurations} "${_configurations}" PARENT_SCOPE)
endfunction()

function(_aros_sdk_compiler_options_to_append out_options flags language)
    get_property(_arch GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_ARCH)
    get_property(_cpu GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_CPU)
    get_property(_fpu GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_FPU)
    get_property(_code_model GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_CODE_MODEL)
    set(_options "")
    _aros_sdk_reject_cpu_architecture_override("${language}" "${language} flags" "${flags}")
    foreach(_option_name IN ITEMS march mcpu mfpu mcmodel)
        if(_option_name STREQUAL "march")
            set(_fact_name COMPILER_ARCH)
            set(_value "${_arch}")
        elseif(_option_name STREQUAL "mcpu")
            set(_fact_name COMPILER_CPU)
            set(_value "${_cpu}")
        elseif(_option_name STREQUAL "mfpu")
            set(_fact_name COMPILER_FPU)
            set(_value "${_fpu}")
        else()
            set(_fact_name COMPILER_CODE_MODEL)
            set(_value "${_code_model}")
        endif()
        _aros_sdk_count_compiler_options(_count _exact _split
            "${flags}" "${_option_name}" "${_value}")
        if(_split)
            _aros_native_consumer_fail(
                "${language} flags use split -${_option_name} syntax; source SDK options must use -${_option_name}=<value>")
        endif()
        if(_value STREQUAL "")
            if(_count GREATER 0)
                _aros_native_consumer_fail(
                    "${language} flags contain an undeclared -${_option_name} option; SDK ABI.${_fact_name} is absent")
            endif()
        elseif(_count EQUAL 0)
            list(APPEND _options "-${_option_name}=${_value}")
        elseif(NOT _count EQUAL 1 OR NOT _exact EQUAL 1)
            _aros_native_consumer_fail(
                "${language} flags must contain exactly one selected -${_option_name}=${_value} option")
        endif()
    endforeach()
    _aros_sdk_reject_cpu_architecture_override("${language}" "${language} flags" "${flags}")
    set(${out_options} "${_options}" PARENT_SCOPE)
endfunction()

function(_aros_sdk_validate_language_compiler_options language)
    get_property(_arch GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_ARCH)
    get_property(_cpu GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_CPU)
    get_property(_fpu GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_FPU)
    get_property(_code_model GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_CODE_MODEL)
    set(_general "CMAKE_${language}_FLAGS")
    _aros_sdk_reconcile_float_abi(_checked "${${_general}}" "${language}" FALSE)
    _aros_sdk_reject_cpu_architecture_override("${language}" "${_general}" "${${_general}}")
    _aros_sdk_reconcile_compiler_option(_checked "${${_general}}" "${language}"
        march COMPILER_ARCH "${_arch}" FALSE)
    _aros_sdk_reconcile_compiler_option(_checked "${${_general}}" "${language}"
        mcpu COMPILER_CPU "${_cpu}" FALSE)
    _aros_sdk_reconcile_compiler_option(_checked "${${_general}}" "${language}"
        mfpu COMPILER_FPU "${_fpu}" FALSE)
    _aros_sdk_reconcile_compiler_option(_checked "${${_general}}" "${language}"
        mcmodel COMPILER_CODE_MODEL "${_code_model}" FALSE)
    _aros_sdk_get_configuration_names(_configurations)
    foreach(_configuration IN LISTS _configurations)
        set(_variable "CMAKE_${language}_FLAGS_${_configuration}")
        set(_init_variable "${_variable}_INIT")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_variable}"
            march COMPILER_ARCH "${_arch}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_init_variable}"
            march COMPILER_ARCH "${_arch}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_variable}"
            mcpu COMPILER_CPU "${_cpu}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_variable}"
            mfpu COMPILER_FPU "${_fpu}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_init_variable}"
            mcpu COMPILER_CPU "${_cpu}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_init_variable}"
            mfpu COMPILER_FPU "${_fpu}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_variable}"
            mcmodel COMPILER_CODE_MODEL "${_code_model}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_init_variable}"
            mcmodel COMPILER_CODE_MODEL "${_code_model}")
        _aros_sdk_reject_configuration_float_abi("${language}" "${_variable}")
        _aros_sdk_reject_configuration_float_abi("${language}" "${_init_variable}")
    endforeach()
    _aros_sdk_reject_cpu_architecture_override("${language}" "${_general}" "${${_general}}")
    foreach(_configuration IN LISTS _configurations)
        set(_variable "CMAKE_${language}_FLAGS_${_configuration}")
        set(_init_variable "${_variable}_INIT")
        if(DEFINED ${_variable})
            _aros_sdk_reject_cpu_architecture_override("${language}" "${_variable}"
                "${${_variable}}")
        endif()
        if(DEFINED ${_init_variable})
            _aros_sdk_reject_cpu_architecture_override("${language}" "${_init_variable}"
                "${${_init_variable}}")
        endif()
    endforeach()
endfunction()

function(_aros_sdk_write_compiler_cache_flags variable value language)
    if("${value}" STREQUAL "${${variable}}")
        return()
    endif()
    get_property(_cache_set CACHE "${variable}" PROPERTY TYPE SET)
    if(_cache_set)
        get_property(_help CACHE "${variable}" PROPERTY HELPSTRING)
    else()
        set(_help "Flags used by the ${language} compiler")
    endif()
    set(${variable} "${value}" CACHE STRING "${_help}" FORCE)
    set(${variable} "${value}" PARENT_SCOPE)
endfunction()

function(aros_register_sdk_consumer_compiler_option_overrides)
    get_property(_schema GLOBAL PROPERTY AROS_NATIVE_CONSUMER_VALIDATED_SCHEMA)
    if(NOT _schema STREQUAL "aros-sdk-consumer-validation-v1")
        return()
    endif()
    _aros_native_consumer_current(_source _contract _digest)
    if(AROS_CROSS_TOOLCHAIN_ROOT)
        set(_toolchain_root "${AROS_CROSS_TOOLCHAIN_ROOT}")
    elseif(DEFINED ENV{AROS_CROSS_TOOLCHAIN_ROOT} AND
           NOT "$ENV{AROS_CROSS_TOOLCHAIN_ROOT}" STREQUAL "")
        set(_toolchain_root "$ENV{AROS_CROSS_TOOLCHAIN_ROOT}")
    else()
        _aros_native_consumer_fail(
            "generic SDK consumer requires AROS_CROSS_TOOLCHAIN_ROOT before compiler detection")
    endif()
    if(NOT IS_DIRECTORY "${_toolchain_root}")
        _aros_native_consumer_fail(
            "generic SDK consumer requires an existing measured toolchain root: ${_toolchain_root}")
    endif()
    set(AROS_NATIVE_CONSUMER_VALIDATED_GENERIC_SDK TRUE CACHE INTERNAL
        "The locked native consumer uses the generic LLVM SDK schema" FORCE)

    # The global override remains in place. There is no portable way to chain
    # two per-language CMake rule overrides, so fail rather than silently
    # replacing a caller's C, CXX, or ASM override.
    foreach(_language IN ITEMS C CXX ASM)
        set(_variable "CMAKE_USER_MAKE_RULES_OVERRIDE_${_language}")
        set(_module
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/SdkConsumerCompilerOptions${_language}.cmake")
        if(DEFINED ${_variable} AND NOT "${${_variable}}" STREQUAL "" AND
           NOT "${${_variable}}" STREQUAL "${_module}")
            _aros_native_consumer_fail(
                "${_variable} is already set; generic SDK compiler options require the engine language override")
        endif()
        set(${_variable} "${_module}" PARENT_SCOPE)
    endforeach()
endfunction()

function(aros_apply_sdk_consumer_compiler_options_for_language language)
    if(NOT language MATCHES "^(C|CXX|ASM)$")
        _aros_native_consumer_fail("unsupported SDK compiler-option language: ${language}")
    endif()
    get_property(_schema GLOBAL PROPERTY AROS_NATIVE_CONSUMER_VALIDATED_SCHEMA)
    if(NOT _schema STREQUAL "aros-sdk-consumer-validation-v1")
        return()
    endif()
    _aros_native_consumer_current(_source _contract _digest)

    set(_general "CMAKE_${language}_FLAGS")
    set(_init "CMAKE_${language}_FLAGS_INIT")
    get_property(_cache_set CACHE "${_general}" PROPERTY TYPE SET)
    if(_cache_set OR DEFINED ${_general})
        # An explicit general-flags value is authoritative. In particular,
        # do not replace cache values with a reconstructed ENV/INIT value.
        set(_mode explicit)
        set(_effective_flags "${${_general}}")
    else()
        # CMake's language-information files prefix ENV{CFLAGS/CXXFLAGS/
        # ASMFLAGS} to *_FLAGS_INIT immediately after this hook. Validate
        # their combined effective input here, but add only the missing
        # selected options to *_FLAGS_INIT so the environment is not copied
        # into the eventual cache a second time.
        set(_mode initial)
        if(language STREQUAL "C")
            set(_environment_flags "$ENV{CFLAGS}")
        elseif(language STREQUAL "CXX")
            set(_environment_flags "$ENV{CXXFLAGS}")
        else()
            set(_environment_flags "$ENV{ASMFLAGS}")
        endif()
        set(_effective_flags "${_environment_flags} ${${_init}}")
        string(STRIP "${_effective_flags}" _effective_flags)
    endif()

    _aros_sdk_compiler_options_to_append(_missing_options
        "${_effective_flags}" "${language}")
    _aros_sdk_reconcile_float_abi(_effective_flags_with_float
        "${_effective_flags}" "${language}" TRUE)
    if(NOT _effective_flags_with_float STREQUAL _effective_flags)
        set(_float_abi_added TRUE)
    else()
        set(_float_abi_added FALSE)
    endif()
    get_property(_arch GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_ARCH)
    get_property(_cpu GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_CPU)
    get_property(_fpu GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_FPU)
    get_property(_code_model GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_COMPILER_CODE_MODEL)
    _aros_sdk_get_configuration_names(_configurations)
    foreach(_configuration IN LISTS _configurations)
        set(_variable "CMAKE_${language}_FLAGS_${_configuration}")
        set(_init_variable "${_variable}_INIT")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_variable}"
            march COMPILER_ARCH "${_arch}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_init_variable}"
            march COMPILER_ARCH "${_arch}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_variable}"
            mcpu COMPILER_CPU "${_cpu}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_variable}"
            mfpu COMPILER_FPU "${_fpu}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_init_variable}"
            mcpu COMPILER_CPU "${_cpu}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_init_variable}"
            mfpu COMPILER_FPU "${_fpu}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_variable}"
            mcmodel COMPILER_CODE_MODEL "${_code_model}")
        _aros_sdk_reject_configuration_compiler_option("${language}" "${_init_variable}"
            mcmodel COMPILER_CODE_MODEL "${_code_model}")
        _aros_sdk_reject_configuration_float_abi("${language}" "${_variable}")
        _aros_sdk_reject_configuration_float_abi("${language}" "${_init_variable}")
        if(DEFINED ${_variable})
            _aros_sdk_reject_cpu_architecture_override("${language}" "${_variable}"
                "${${_variable}}")
        endif()
        if(DEFINED ${_init_variable})
            _aros_sdk_reject_cpu_architecture_override("${language}" "${_init_variable}"
                "${${_init_variable}}")
        endif()
    endforeach()

    if(NOT _missing_options AND NOT _float_abi_added)
        return()
    endif()
    if(_mode STREQUAL "initial")
        set(_updated "${${_init}}")
        if(_float_abi_added)
            if(NOT _updated STREQUAL "")
                string(APPEND _updated " ")
            endif()
            get_property(_float_abi GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_FLOAT_ABI)
            string(APPEND _updated "-mfloat-abi=${_float_abi}")
        endif()
        if(_missing_options)
            string(JOIN " " _suffix ${_missing_options})
            if(NOT _updated STREQUAL "")
                string(APPEND _updated " ")
            endif()
            string(APPEND _updated "${_suffix}")
        endif()
        set(${_init} "${_updated}" PARENT_SCOPE)
    else()
        set(_updated "${_effective_flags}")
        if(_float_abi_added)
            if(NOT _updated STREQUAL "")
                string(APPEND _updated " ")
            endif()
            get_property(_float_abi GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_FLOAT_ABI)
            string(APPEND _updated "-mfloat-abi=${_float_abi}")
        endif()
        if(_missing_options)
            string(JOIN " " _suffix ${_missing_options})
            if(NOT _updated STREQUAL "")
                string(APPEND _updated " ")
            endif()
            string(APPEND _updated "${_suffix}")
        endif()
        if(_cache_set)
            _aros_sdk_write_compiler_cache_flags("${_general}" "${_updated}" "${language}")
        else()
            set(${_general} "${_updated}" PARENT_SCOPE)
        endif()
        if(_cache_set)
            set(${_general} "${_updated}" PARENT_SCOPE)
        endif()
    endif()
endfunction()

function(_aros_sdk_validate_language_target_flags language)
    get_property(_float_abi GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_FLOAT_ABI)
    set(_general "CMAKE_${language}_FLAGS")
    set(_flag_variables "${_general}")
    _aros_sdk_get_configuration_names(_configurations)
    foreach(_configuration IN LISTS _configurations)
        list(APPEND _flag_variables
            "CMAKE_${language}_FLAGS_${_configuration}"
            "CMAKE_${language}_FLAGS_${_configuration}_INIT")
    endforeach()

    set(_float_count 0)
    foreach(_variable IN LISTS _flag_variables)
        if(NOT DEFINED ${_variable} OR "${${_variable}}" STREQUAL "")
            continue()
        endif()
        separate_arguments(_flags UNIX_COMMAND "${${_variable}}")
        foreach(_flag IN LISTS _flags)
            if(_flag MATCHES "^(-target|--target|--?sysroot|-isysroot)" OR
               _flag MATCHES "^-m(32|64)$")
                _aros_native_consumer_fail(
                    "${language} flags cannot override the selected target or sysroot")
            endif()
            if(_flag MATCHES "^-mfloat-abi")
                math(EXPR _float_count "${_float_count} + 1")
                if(NOT "${_variable}" STREQUAL "${_general}" OR
                   NOT _flag STREQUAL "-mfloat-abi=${_float_abi}")
                    _aros_native_consumer_fail(
                        "${language} float ABI flags differ from the selected SDK target")
                endif()
            endif()
        endforeach()
    endforeach()

    if(AROS_TARGET_CPU STREQUAL "arm")
        if(NOT _float_abi MATCHES "^(hard|soft|softfp)$" OR NOT _float_count EQUAL 1)
            _aros_native_consumer_fail(
                "ARM SDK requires exactly one selected float ABI flag per driver")
        endif()
    elseif(NOT _float_count EQUAL 0 OR NOT _float_abi STREQUAL "")
        _aros_native_consumer_fail("non-ARM LLVM SDK cannot inherit ARM float ABI flags")
    endif()
endfunction()

function(_aros_validate_sdk_consumer_compiler_target)
    if(NOT AROS_TOOLCHAIN STREQUAL "llvm")
        _aros_native_consumer_fail("generic SDK compiler adapter requires LLVM")
    endif()
    get_property(_width GLOBAL PROPERTY AROS_SDK_CONSUMER_VALIDATED_POINTER_WIDTH)
    math(EXPR _bytes "${_width} / 8")
    if(NOT CMAKE_SIZEOF_VOID_P STREQUAL _bytes)
        _aros_native_consumer_fail("detected compiler pointer width differs from the SDK target")
    endif()
    foreach(_language IN ITEMS C CXX ASM)
        if(_language STREQUAL "C" OR _language STREQUAL "CXX")
            if(NOT CMAKE_${_language}_COMPILER_ID STREQUAL "Clang" OR
               NOT CMAKE_${_language}_COMPILER_TARGET STREQUAL AROS_TARGET_TRIPLE)
                _aros_native_consumer_fail(
                    "${_language} driver must be Clang with the exact SDK target triple")
            endif()
        elseif(NOT CMAKE_ASM_COMPILER_ID MATCHES "^(Clang|AppleClang)$" OR
               NOT CMAKE_ASM_COMPILER_TARGET STREQUAL AROS_TARGET_TRIPLE)
            _aros_native_consumer_fail(
                "ASM driver must be Clang with the exact SDK target triple")
        endif()
        _aros_sdk_validate_language_target_flags("${_language}")
    endforeach()
    foreach(_language IN ITEMS C CXX ASM)
        _aros_sdk_validate_language_compiler_options("${_language}")
    endforeach()
endfunction()
