include_guard(GLOBAL)

# Retain the actual writefiles manifest, not a guessed genmodule directory
# prefix. Nominal Make coordinates are supplied separately by the source
# evaluator; GEN and LINKLIB identify the producer's two explicit output lanes.
function(_aros_register_genmodule_sources owner declaration config override gen_dir stub_dir)
    file(SHA256 "${config}" _config_sha)
    set(_override_sha "")
    if(override)
        file(SHA256 "${override}" _override_sha)
    endif()
    foreach(_source IN LISTS ARGN)
        if(NOT _source MATCHES "[.]c$")
            continue()
        endif()
        get_filename_component(_parent "${_source}" DIRECTORY)
        get_filename_component(_name "${_source}" NAME)
        if("${_parent}" STREQUAL "${gen_dir}")
            set(_lane GEN)
        elseif("${_parent}" STREQUAL "${stub_dir}")
            set(_lane LINKLIB)
        else()
            message(FATAL_ERROR "genmodule manifest source has no declared output lane")
        endif()
        string(SHA256 _key "${_source}")
        foreach(_field IN ITEMS OWNER DECLARATION CONFIG CONFIG_SHA OVERRIDE OVERRIDE_SHA LANE NAME)
            if("${_field}" STREQUAL "OWNER")
                set(_value "${owner}")
            elseif("${_field}" STREQUAL "DECLARATION")
                set(_value "${declaration}")
            elseif("${_field}" STREQUAL "CONFIG")
                set(_value "${config}")
            elseif("${_field}" STREQUAL "OVERRIDE")
                set(_value "${override}")
            else()
                string(TOLOWER "${_field}" _variable)
                set(_value "${_${_variable}}")
            endif()
            set(_property "AROS_GENMODULE_SOURCE_${_key}_${_field}")
            get_property(_present GLOBAL PROPERTY "${_property}" SET)
            get_property(_prior GLOBAL PROPERTY "${_property}")
            if(_present AND NOT "${_prior}" STREQUAL "${_value}")
                message(FATAL_ERROR "genmodule source has conflicting producer metadata")
            endif()
            set_property(GLOBAL PROPERTY "${_property}" "${_value}")
        endforeach()
    endforeach()
endfunction()

# Generated C sources may not exist yet. Their authority is the registered
# custom-command manifest plus unchanged declaration inputs, not file existence.
function(_aros_genmodule_source_origin prefix source owner)
    string(SHA256 _key "${source}")
    get_property(_owner GLOBAL PROPERTY "AROS_GENMODULE_SOURCE_${_key}_OWNER")
    if(NOT _owner OR NOT "${_owner}" STREQUAL "${owner}")
        message(FATAL_ERROR "generated Mesa source has no matching genmodule owner")
    endif()
    foreach(_field IN ITEMS OWNER DECLARATION CONFIG CONFIG_SHA OVERRIDE OVERRIDE_SHA LANE NAME)
        get_property(_${_field} GLOBAL PROPERTY "AROS_GENMODULE_SOURCE_${_key}_${_field}")
        set(${prefix}_${_field} "${_${_field}}" PARENT_SCOPE)
    endforeach()
    foreach(_input IN ITEMS CONFIG OVERRIDE)
        if("${_input}" STREQUAL "OVERRIDE" AND NOT _OVERRIDE)
            continue()
        endif()
        if(NOT EXISTS "${_${_input}}" OR IS_DIRECTORY "${_${_input}}" OR
           IS_SYMLINK "${_${_input}}")
            message(FATAL_ERROR "genmodule source declaration input is not a regular file")
        endif()
        file(REAL_PATH "${_${_input}}" _canonical)
        file(SHA256 "${_${_input}}" _sha)
        if(NOT "${_canonical}" STREQUAL "${_${_input}}" OR
           NOT "${_sha}" STREQUAL "${_${_input}_SHA}")
            message(FATAL_ERROR "genmodule source declaration input changed")
        endif()
    endforeach()
endfunction()
