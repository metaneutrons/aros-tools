{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metaneutrons/aros-toolchains/toolchains/toolchain-manifest-v2.schema.json",
  "$comment": "Structural validation only. ArosToolchainManifest::validate remains authoritative for semantic cross-field checks; this schema does not prove recipe bindings, digests over bytes, or the installed filesystem inventory.",
  "title": "AROS release toolchain manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "host",
    "target_profile",
    "target_triple",
    "tree_sha256",
    "compiler",
    "recipe_sha256",
    "source_lock_sha256",
    "profiles_sha256",
    "source_commit",
    "producer_commit",
    "tools_commit",
    "source_date_epoch",
    "capabilities",
    "build_environment",
    "files"
  ],
  "properties": {
    "schema": { "const": 2 },
    "release_id": { "$ref": "#/$defs/segment" },
    "host": { "$ref": "#/$defs/segment" },
    "target_profile": { "$ref": "#/$defs/segment" },
    "target_triple": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tree_sha256": { "$ref": "#/$defs/sha256" },
    "compiler": { "$ref": "#/$defs/compiler" },
    "recipe_sha256": { "$ref": "#/$defs/sha256" },
    "source_lock_sha256": { "$ref": "#/$defs/sha256" },
    "profiles_sha256": { "$ref": "#/$defs/sha256" },
    "source_commit": { "$ref": "#/$defs/gitCommit" },
    "producer_commit": { "$ref": "#/$defs/gitCommit" },
    "tools_commit": { "$ref": "#/$defs/gitCommit" },
    "source_date_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "build_environment": {
      "type": "object",
      "additionalProperties": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/directoryEntry" },
          { "$ref": "#/$defs/fileEntry" },
          { "$ref": "#/$defs/symlinkEntry" }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "compiler": {
            "properties": { "family": { "const": "gnu" } }
          }
        }
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "compiler": {
                  "properties": {
                    "target": {
                      "properties": {
                        "abi": { "enum": ["ilp32", "ilp32f", "ilp32d"] }
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "target_triple": {
                  "minLength": 10,
                  "maxLength": 133,
                  "not": { "pattern": "[^A-Za-z0-9_.-]" },
                  "pattern": "^riscv(?:-(?!(?:\\.{1,2})(?:-|$))[A-Za-z0-9_.]+)*-aros$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "compiler": {
                  "properties": {
                    "target": {
                      "properties": {
                        "abi": { "enum": ["lp64", "lp64f", "lp64d"] }
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "target_triple": {
                  "minLength": 12,
                  "maxLength": 133,
                  "not": { "pattern": "[^A-Za-z0-9_.-]" },
                  "pattern": "^riscv64(?:-(?!(?:\\.{1,2})(?:-|$))[A-Za-z0-9_.]+)*-aros$"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "segment": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "not": { "enum": [".", ".."] } },
        { "not": { "pattern": "[/\\\\]" } }
      ]
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "llvmVersion": {
      "type": "string",
      "not": { "pattern": "[^0-9.]" },
      "pattern": "^(?:[0-9]{1,9}|0[0-9]{9}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])\\.(?:[0-9]{1,9}|0[0-9]{9}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])\\.(?:[0-9]{1,9}|0[0-9]{9}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
    },
    "gccVersion": {
      "type": "string",
      "not": { "pattern": "[^0-9.]" },
      "pattern": "^(?:[0-9]{1,9}|0[0-9]{9}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])\\.(?:[0-9]{1,9}|0[0-9]{9}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])\\.(?:[0-9]{1,9}|0[0-9]{9}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
    },
    "binutilsVersion": {
      "type": "string",
      "not": { "pattern": "[^0-9.]" },
      "pattern": "^(?:[0-9]{1,9}|0[0-9]{9}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])\\.(?:[0-9]{1,9}|0[0-9]{9}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])(?:\\.(?:[0-9]{1,9}|0[0-9]{9}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])(?:\\.(?:[0-9]{1,9}|0[0-9]{9}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7]))?)?$"
    },
    "compiler": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "version"],
          "properties": {
            "family": { "const": "llvm" },
            "version": { "$ref": "#/$defs/llvmVersion" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "gcc_version", "binutils_version", "target"],
          "properties": {
            "family": { "const": "gnu" },
            "gcc_version": { "$ref": "#/$defs/gccVersion" },
            "binutils_version": { "$ref": "#/$defs/binutilsVersion" },
            "target": { "$ref": "#/$defs/riscvTargetContract" }
          }
        }
      ]
    },
    "riscvTargetContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "isa",
        "abi",
        "code_model",
        "architecture",
        "unaligned_access",
        "atomic_abi",
        "x3_reg_usage"
      ],
      "properties": {
        "schema": { "const": "aros-riscv-target-v1" },
        "isa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "not": { "pattern": "[^a-z0-9_]" },
          "pattern": "^[a-z0-9_]+$"
        },
        "abi": { "enum": ["ilp32", "ilp32f", "ilp32d", "lp64", "lp64f", "lp64d"] },
        "code_model": { "enum": ["medlow", "medany"] },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "not": { "pattern": "[^a-z0-9_]" },
          "pattern": "^[a-z0-9_]+$"
        },
        "unaligned_access": { "type": "boolean" },
        "atomic_abi": { "type": "integer", "minimum": 0, "maximum": 3 },
        "x3_reg_usage": { "type": "integer", "minimum": 0, "maximum": 3 }
      },
      "allOf": [
        {
          "if": { "properties": { "abi": { "enum": ["ilp32", "ilp32f", "ilp32d"] } } },
          "then": {
            "properties": {
              "isa": { "pattern": "^rv32i" },
              "architecture": { "pattern": "^rv32i[0-9]+p[0-9]+(?:_|$)" }
            }
          }
        },
        {
          "if": { "properties": { "abi": { "enum": ["lp64", "lp64f", "lp64d"] } } },
          "then": {
            "properties": {
              "isa": { "pattern": "^(?:rv64i[a-z0-9_]*|rva[a-z0-9_]*u64)$" },
              "architecture": { "pattern": "^rv64i[0-9]+p[0-9]+(?:_|$)" }
            }
          }
        },
        {
          "if": { "properties": { "abi": { "enum": ["ilp32f", "lp64f"] } } },
          "then": { "properties": { "architecture": { "pattern": "(?:^|_)f[0-9]" } } }
        },
        {
          "if": { "properties": { "abi": { "enum": ["ilp32d", "lp64d"] } } },
          "then": {
            "properties": {
              "architecture": {
                "allOf": [
                  { "pattern": "(?:^|_)f[0-9]" },
                  { "pattern": "(?:^|_)d[0-9]" }
                ]
              }
            }
          }
        }
      ]
    },
    "inventoryPath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "pattern": "^[^/]" },
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": "^\\.(?:/|(?![\\s\\S]))" } },
        { "not": { "pattern": "(^|/)\\.\\.(?:/|(?![\\s\\S]))" } },
        { "not": { "const": "toolchain-manifest.json" } }
      ]
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "directoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "type"],
      "properties": {
        "path": { "$ref": "#/$defs/inventoryPath" },
        "mode": { "const": "0755" },
        "type": { "const": "directory" },
        "sha256": { "type": "null" },
        "size": { "type": "null" },
        "target": { "type": "null" }
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "type", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/inventoryPath" },
        "mode": { "enum": ["0644", "0755"] },
        "type": { "const": "file" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "$ref": "#/$defs/u64" },
        "target": { "type": "null" }
      }
    },
    "symlinkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "type", "target"],
      "properties": {
        "path": { "$ref": "#/$defs/inventoryPath" },
        "mode": { "const": "0777" },
        "type": { "const": "symlink" },
        "sha256": { "type": "null" },
        "size": { "type": "null" },
        "target": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            { "pattern": "^[^/]" },
            { "not": { "pattern": "\\\\" } }
          ]
        }
      }
    }
  }
}
